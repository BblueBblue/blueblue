  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: BookDataStringTable_ko
  m_EditorClassIdentifier: 
  m_LocaleId:
    m_Code: ko
  m_SharedData: {fileID: 11400000, guid: 0e1eb430fb7668243beccccafa381d9a, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 635322368
    m_Localized: "\uC624\uB298\uB3C4 \uACF5\uB180\uC774\uB97C \uD63C\uC790 \uD588\uC5B4.
      \uACF5\uC744 \uC138\uAC8C \uCC28\uBA74 \uBCBD\uC5D0 \uBD80\uB52A\uD788\uACE0
      \uB2E4\uC2DC \uB3CC\uC544\uC624\uB294\uB370, \uADF8\uB54C\uAC00 \uC81C\uC77C
      \uC2E0\uB098. \uC61B\uB0A0\uC5D0\uB294 \uC544\uBE60\uB791 \uAC19\uC774 \uD588\uC5C8\uB294\uB370,
      \uC774\uC81C\uB294 \uD63C\uC790 \uD574\uC57C \uD574\uC11C \uC880 \uC2EC\uC2EC\uD574.
      \uADF8\uB798\uB3C4 \uACF5\uC740 \uB0B4 \uB9D0 \uC798 \uB4E4\uC5B4\uC918\uC11C
      \uC88B\uC544. \uB0B4\uC77C\uC740 \uACF5\uC744 \uB354 \uBA40\uB9AC \uCC28\uB294
      \uC5F0\uC2B5\uC744 \uD574\uBCFC \uAC70\uC57C!"
    m_Metadata:
      m_Items: []
  - m_Id: 673071104
    m_Localized: "\uBCBD\uC5D0\uC11C \uBE68\uAC04 \uD53C\uAC00 \uD750\uB974\uB294
      \uAC78 \uBD24\uC5B4. \uCC98\uC74C\uC5D4 \uBB3C\uC778 \uC904 \uC54C\uC558\uB294\uB370,
      \uC810\uC810 \uB354 \uBE68\uAC1B\uACE0 \uB048\uC801\uD574 \uBCF4\uC5EC\uC11C
      \uB108\uBB34 \uBB34\uC11C\uC6E0\uC5B4. \uADF8\uB0E5 \uAFC8\uC774\uC5C8\uB294\uB370,
      \uC9C4\uC9DC\uCC98\uB7FC \uB290\uAEF4\uC84C\uC5B4. \uD53C\uB97C \uBCF4\uBA74
      \uC5B4\uC9C0\uB7FD\uACE0 \uC228\uC774 \uB9C9\uD788\uB294 \uAC83 \uAC19\uC544.
      \uB09C \uD53C\uAC00 \uB108\uBB34 \uC2EB\uB2E4"
    m_Metadata:
      m_Items: []
  - m_Id: 677265408
    m_Localized: "\uC624\uB298 \uC544\uBE60 \uC11C\uC7AC\uC5D0\uC11C \uCC45\uC744
      \uBCF4\uB2E4\uAC00 \uC2DC\uACC4\uB97C \uBD24\uC5B4. \uADF8\uB7F0\uB370 \uC2DC\uAC04\uC774
      \uC774\uC0C1\uD55C\uAC70\uC57C! \uB0B4\uAC00 \uC2DC\uAC04\uC744 \uC798\uBABB
      \uBCF8 \uC904 \uC54C\uC558\uB294\uB370, \uB2E4\uC2DC \uBD10\uB3C4 \uC774\uC0C1\uD588\uC5B4.
      \uC2DC\uAC04 \uAC00\uB294 \uC904 \uBAA8\uB974\uACE0 \uB108\uBB34 \uC624\uB798
      \uB180\uC558\uB098 \uC2F6\uC5B4\uC11C \uC5BC\uB978 \uB098\uC654\uC5B4. \uB2E4\uC74C\uC5D4
      \uC11C\uC7AC\uC5D0 \uC624\uB798 \uC788\uC9C0 \uB9D0\uC544\uC57C\uACA0\uB2E4\uACE0
      \uC0DD\uAC01\uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 677265409
    m_Localized: "\uC624\uB298 \uC544\uCE68\uC5D0 \uC637\uAC78\uC774\uB97C \uBD24\uB294\uB370,
      \uAC78\uC5B4\uB454 \uC637 \uC0C9\uAE54\uC774 \uBC14\uB00C\uC5B4 \uC788\uC5C8\uC5B4.
      \uC5B4\uC81C\uB791 \uB2E4\uB974\uAC8C \uBCF4\uC774\uB294 \uAC8C \uC774\uC0C1\uD574\uC11C
      \uACC4\uC18D \uCCD0\uB2E4\uBD24\uB294\uB370, \uB0B4\uAC00 \uC798\uBABB \uBCF8
      \uAC74\uC9C0 \uBAA8\uB974\uACA0\uC5B4. \uC637\uC774 \uC65C \uBC14\uB010 \uAC74\uC9C0
      \uC0DD\uAC01\uD558\uBA74 \uC880 \uC774\uC0C1\uD558\uACE0 \uBB34\uC11C\uC6B4
      \uB290\uB08C\uC774 \uB4E4\uC5C8\uC5B4. \uB0B4\uC77C \uB2E4\uC2DC \uBCF4\uBA74
      \uC6D0\uB798\uB300\uB85C \uB3CC\uC544\uC640 \uC788\uC744\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 681459712
    m_Localized: "\uC637\uAC78\uC774\uB294 \uBB34\uC11C\uC6CC. \uC637\uC774 \uAC78\uB824\uC788\uB294
      \uAC78 \uBCF4\uBA74 \uB108\uBB34 \uC0AC\uB78C\uAC19\uC544.. \uCC28\uB77C\uB9AC
      \uC800 \uC637\uC744 \uB2E4 \uC5C6\uC560\uBC84\uB9AC\uB294\uAC8C \uB0AB\uC9C0
      \uC54A\uC744\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 681459713
    m_Localized: "\uAD50\uBCF5\uC744 \uBCF4\uB2C8, \uCE58\uC6B0\uC9C0 \uBABB\uD55C
      \uBC1C\uC790\uAD6D\uC774 \uADF8\uB300\uB85C \uB0A8\uC544 \uC788\uC5C8\uB2E4.
      \uC218\uC5C5 \uB05D\uB098\uACE0 \uBCF5\uB3C4\uC5D0\uC11C \uB204\uAD70\uAC00\uAC00
      \uC77C\uBD80\uB7EC \uBC00\uACE0 \uBC1F\uACE0 \uAC04 \uAC8C \uBD84\uBA85\uD55C\uB370,
      \uC544\uBB34 \uB9D0\uB3C4 \uBABB \uD55C \uB0B4\uAC00 \uB108\uBB34 \uD654\uAC00
      \uB0AC\uB2E4. \uBB3C\uB85C \uC9C0\uC6CC\uBCF4\uB824 \uD588\uC9C0\uB9CC, \uC790\uAD6D\uC740
      \uC27D\uAC8C \uC9C0\uC6CC\uC9C0\uC9C0 \uC54A\uC558\uB2E4. \uADF8 \uBC1C\uC790\uAD6D\uC774
      \uB9C8\uCE58 \uB0B4 \uC790\uC874\uC2EC \uC704\uC5D0 \uCC0D\uD78C \uAC83 \uAC19\uC544
      \uB354 \uACAC\uB514\uAE30 \uD798\uB4E4\uC5C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 681459714
    m_Localized: "\uC624\uB298 \uAFC8\uC5D0\uC11C \uC637\uAC78\uC774\uAC00 \uAC11\uC790\uAE30
      \uC0AC\uB78C\uCC98\uB7FC \uC6C0\uC9C1\uC600\uC5B4. \uD314\uC774 \uAE38\uC5B4\uC9C0\uB354\uB2C8
      \uB098\uB97C \uCAD3\uC544\uC624\uAE30 \uC2DC\uC791\uD588\uC5B4. \uB098\uB294
      \uC228\uC73C\uB824\uACE0 \uB6F0\uC5C8\uB294\uB370, \uC790\uAFB8 \uB4A4\uC5D0\uC11C
      \uB0A0 \uC7A1\uC73C\uB824\uACE0 \uC190\uC744 \uBED7\uC5C8\uC5B4. \uAD34\uBB3C\uC774
      \uB098\uB97C \uC8FD\uC774\uB824\uACE0 \uC18C\uB9AC\uCE58\uB294\uB370 \uB108\uBB34
      \uBB34\uC11C\uC6CC\uC11C \uC18C\uB9AC\uB3C4 \uBABB \uB0C8\uC5B4. \uAFC8\uC5D0\uC11C
      \uAE68\uACE0 \uB098\uB2C8\uAE4C \uC637\uAC78\uC774\uB97C \uB2E4\uC2DC \uBCF4\uAE30\uAC00
      \uC2EB\uC5B4\uC84C\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 681459715
    m_Localized: "\uC624\uB298 \uBC24\uC5D0\uB3C4 \uBC29\uC774 \uAE5C\uAE5C\uD574\uC838\uC11C
      \uB108\uBB34 \uBB34\uC11C\uC6E0\uC5B4. \uBD88\uC744 \uB044\uBA74 \uB098\uB97C
      \uC7A1\uC73C\uB7EC \uBB34\uC5B8\uAC00\uAC00 \uC62C \uAC83 \uAC19\uC544. \uC774\uBD88
      \uC18D\uC5D0 \uC228\uC5B4 \uC788\uC73C\uBA74 \uC870\uAE08 \uB35C \uBB34\uC11C\uC6B4\uB370,
      \uADF8\uB798\uB3C4 \uAC00\uB054 \uB208\uBB3C\uC774 \uB098\uC640. \uC5C4\uB9C8\uB098
      \uC544\uBE60\uAC00 \uC788\uC73C\uBA74 \uAD1C\uCC2E\uC744 \uD150\uB370, \uC5C6\uC73C\uB2C8\uAE4C
      \uB0B4\uAC00 \uD63C\uC790 \uB2E4 \uCC38\uC544\uC57C \uD574. \uB0B4\uC77C\uC740
      \uBC24\uC5D0 \uBD88 \uB044\uC9C0 \uB9D0\uACE0 \uC798\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 681459716
    m_Localized: "\uC624\uB298 \uC77C\uAE30\uC7A5\uC744 \uBD24\uB294\uB370, \uC885\uC774\uC5D0
      \uD53C \uAC19\uC740 \uAC8C \uBB3B\uC5B4 \uC788\uC5C8\uC5B4. \uC5B8\uC81C \uB2E4\uCE58\uACE0
      \uBB3B\uC740\uAC70\uC9C0?  \uBE68\uAC04 \uC790\uAD6D\uC774 \uBC88\uC838 \uC788\uB294
      \uAC78 \uBCF4\uB2C8\uAE4C \uB108\uBB34 \uBB34\uC11C\uC6E0\uC5B4. \uC774\uAC8C
      \uC65C \uC0DD\uACBC\uB294\uC9C0 \uBAA8\uB974\uACA0\uB294\uB370, \uADF8\uB0E5
      \uB354\uB294 \uBCF4\uC9C0 \uB9D0\uACE0 \uB36E\uC5B4\uB480\uC5B4. \uB0B4\uC77C\uC740
      \uC0C8 \uC77C\uAE30\uC7A5\uC744 \uC368\uC57C \uD560 \uAC83 \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 681459717
    m_Localized: "\uC624\uB298\uB3C4 \uCE68\uB300 \uBC11\uC774 \uB108\uBB34 \uBB34\uC11C\uC6E0\uC5B4.
      \uC798 \uB54C\uB9C8\uB2E4 \uBC11\uC5D0\uC11C \uB204\uAC00 \uB098\uB97C \uCCD0\uB2E4\uBCF4\uB294
      \uAC83 \uAC19\uC544. \uD63C\uC790\uC11C \uC790\uB2C8\uAE4C \uB354 \uBB34\uC11C\uC6B4
      \uC0DD\uAC01\uC774 \uB4DC\uB294 \uAC83 \uAC19\uC544. \uBC1C\uC744 \uCE68\uB300
      \uBC16\uC73C\uB85C \uB0B4\uBC00\uBA74 \uC7A1\uC544\uAC08\uAE4C \uBD10 \uAF2D\uAF2D
      \uC228\uAE30\uACE0 \uC7A4\uC5B4. \uB0B4\uC77C \uB0AE\uC5D0 \uAC00\uC11C \uD55C
      \uBC88 \uC0B4\uC9DD \uB4E4\uC5EC\uB2E4\uBD10\uC57C\uACA0\uC5B4, \uADFC\uB370
      \uB610 \uBCF4\uBA74 \uB354 \uBB34\uC11C\uC6B8\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 681459718
    m_Localized: "\uC624\uB298 \uBC24\uC5D4 \uC9C4\uC9DC \uBB34\uC11C\uC6B4 \uC77C\uC774
      \uC788\uC5C8\uC5B4. \uB208\uC55E\uC5D0 \uBB34\uC11C\uC6B4 \uADC0\uC2E0 \uAC19\uC740
      \uAC8C \uB098\uD0C0\uB09C \uAC70\uC57C. \uB098\uB97C \uAC00\uB9CC\uD788 \uCCD0\uB2E4\uBCF4\uB294\uB370
      \uC228\uB3C4 \uBABB \uC26C\uACA0\uC5C8\uC5B4. \uB0B4\uAC00 \uC774\uBD88\uB85C
      \uC5BC\uAD74\uC744 \uAC00\uB9AC\uB2C8\uAE4C \uC0AC\uB77C\uC84C\uB294\uB370,
      \uB2E4\uC2DC \uB098\uD0C0\uB0A0\uAE4C \uBD10 \uB208\uB3C4 \uBABB \uAC10\uC558\uC5B4.
      \uC774\uB7F0 \uC77C\uC774 \uC790\uAFB8 \uC0DD\uAE30\uBA74 \uC5B4\uB5A1\uD558\uC9C0?
      \uC5C4\uB9C8\uAC00 \uC788\uC5C8\uC73C\uBA74 \uBB34\uC11C\uC6B4 \uAC70 \uB2E4
      \uBB3C\uB9AC\uCCD0\uC92C\uC744 \uD150\uB370\u2026"
    m_Metadata:
      m_Items: []
  - m_Id: 681459719
    m_Localized: "\uC624\uB298 \uAC00\uC871 \uC0AC\uC9C4\uC744 \uCC3E\uC558\uC5B4.
      \uC5C4\uB9C8\uB791 \uC544\uBE60\uAC00 \uAC19\uC774 \uC6C3\uACE0 \uC788\uB294
      \uC0AC\uC9C4\uC778\uB370, \uAC00\uC6B4\uB370\uAC00 \uCC22\uC5B4\uC838 \uC788\uC5C8\uC5B4.
      \uC5C4\uB9C8\uD55C\uD14C \uC65C \uC544\uBE60\uB791 \uC548 \uC0AC\uB0D0\uACE0
      \uBB3C\uC5B4\uBD24\uB354\uB2C8 \uD654\uB97C \uB0C8\uC5B4. \uC544\uBE60\uB294
      \uBC14\uBE60\uC11C \uBABB \uC624\uB294 \uAC70\uB77C\uB294\uB370, \uBC14\uBE60\uB3C4
      \uB098 \uBCF4\uACE0 \uC2F6\uC744 \uD150\uB370. \uC0AC\uC9C4\uC744 \uB2E4\uC2DC
      \uBD99\uC5EC\uBCF4\uB824\uACE0 \uD588\uB294\uB370, \uC798 \uC548 \uB9DE\uC544\uC11C
      \uC774\uC0C1\uD588\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 685654016
    m_Localized: "\uC624\uB298\uB3C4 \uD63C\uC790 \uC9D1\uC5D0 \uC788\uC5C8\uC5B4.
      \uAC00\uB054 \uAC00\uC871\uC774 \uB098\uB97C \uC78A\uC5B4\uBC84\uB9B0 \uAC8C
      \uC544\uB2D0\uAE4C \uD558\uB294 \uC0DD\uAC01\uC774 \uB4E4\uC5B4. \uB2E4\uB978
      \uC0AC\uB78C\uB4E4\uC740 \uAC00\uC871\uC774\uB791 \uAC19\uC774 \uB2E4\uB2C8\uB358\uB370,
      \uC65C \uB098\uB294 \uD63C\uC790\uC77C\uAE4C? \uB0B4\uAC00 \uBB58 \uC798\uBABB\uD574\uC11C
      \uADF8\uB7F0 \uAC78\uAE4C? \uC790\uAFB8 \uC774\uB7F0 \uC0DD\uAC01\uC774 \uB4E4\uBA74
      \uB9C8\uC74C\uC774 \uC544\uD504\uACE0 \uB108\uBB34 \uC678\uB85C\uC6CC\uC838."
    m_Metadata:
      m_Items: []
  - m_Id: 685654017
    m_Localized: "\uC624\uB298 \uBE14\uB85D \uC7A5\uB09C\uAC10\uC73C\uB85C \uB180\uB2E4\uAC00
      \uC774\uC0C1\uD55C \uAC78 \uBD24\uC5B4. \uB0B4\uAC00 \uC313\uC544\uB454 \uBE14\uB85D\uC5D0
      \uAC11\uC790\uAE30 \"Dead\"\uB77C\uB294 \uAE00\uC528\uAC00 \uC801\uD600 \uC788\uC5C8\uC5B4.
      \uB098\uB294 \uADF8\uB7F0 \uB2E8\uC5B4\uB97C \uB9CC\uB4E0 \uC801\uC774 \uC5C6\uB294\uB370,
      \uC65C \uADF8\uB807\uAC8C \uB41C \uAC74\uC9C0 \uBAA8\uB974\uACA0\uC5B4. \uBB34\uC11C\uC6CC\uC11C
      \uBE14\uB85D\uC744 \uC804\uBD80 \uC4F0\uB7EC\uB728\uB838\uB294\uB370, \uACC4\uC18D
      \uADF8 \uAE00\uC528\uAC00 \uB5A0\uC624\uB974\uB294 \uAC83 \uAC19\uC544. \uB0B4\uC77C\uC740
      \uBE14\uB85D\uC744 \uC548 \uAC00\uC9C0\uACE0 \uB180\uC544\uC57C \uD560 \uAC83
      \uAC19\uC544."
    m_Metadata:
      m_Items: []
  - m_Id: 685654018
    m_Localized: "\uC624\uB298 \uBC29\uC5D0\uC11C \uD63C\uC790 \uB180\uB2E4\uAC00
      \uC7A5\uB09C\uAC10\uC744 \uB5A8\uC5B4\uB728\uB838\uB2E4. \uADFC\uB370 \uAC11\uC790\uAE30
      \uADF8 \uC7A5\uB09C\uAC10\uC774 \uB098\uB97C \uCCD0\uB2E4\uBCF4\uB294 \uAC83
      \uAC19\uC558\uB2E4. \uB0B4\uAC00 \uC870\uAE08 \uC6C0\uC9C1\uC774\uBA74 \uC7A5\uB09C\uAC10\uB3C4
      \uB530\uB77C\uC624\uB294 \uAC83 \uAC19\uC544\uC11C \uB108\uBB34 \uBB34\uC11C\uC6E0\uC5B4.
      \uC544\uBB34\uB9AC \uBB38\uC744 \uB2EB\uC544\uB3C4 \uC790\uAFB8 \uAFC8\uC5D0
      \uB098\uC62C \uAC83 \uAC19\uC544. \uB0B4\uC77C\uC740 \uADF8 \uC7A5\uB09C\uAC10\uC744
      \uC548 \uBCF4\uC774\uAC8C \uAE4A\uC774 \uC228\uACA8\uC57C\uACA0\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 685654019
    m_Localized: "\uC624\uB298 \uAFC8\uC5D0\uC11C \uBC14\uB2E5\uC5D0\uC11C \uD53C\uAC00
      \uC62C\uB77C\uC624\uB294 \uAC78 \uBD24\uC5B4. \uCC98\uC74C\uC5D4 \uC870\uAE08\uC529
      \uBCF4\uC774\uB354\uB2C8 \uAE08\uC138 \uC9D1 \uC548\uC774 \uC804\uBD80 \uBE68\uAC1B\uAC8C
      \uAC00\uB4DD \uCC3C\uC5B4. \uC228\uC744 \uC274 \uC218 \uC5C6\uC5B4\uC11C \uB108\uBB34
      \uBB34\uC11C\uC6E0\uACE0, \uBC1C\uC774 \uD53C\uC5D0 \uB2FF\uC744\uAE4C \uBD10
      \uAF3C\uC9DD\uB3C4 \uBABB \uD588\uC5B4. \uAFC8\uC5D0\uC11C \uAE68\uACE0 \uB098\uB2C8\uAE4C
      \uC544\uC9C1\uB3C4 \uC2EC\uC7A5\uC774 \uB9C9 \uB450\uADFC\uAC70\uB824."
    m_Metadata:
      m_Items: []
  - m_Id: 685654020
    m_Localized: "\uC624\uB298 \uC2DC\uD5D8\uC9C0\uB97C \uBC1B\uC558\uB294\uB370,
      \uBE68\uAC04 \uD2C0\uB9B0 \uD45C\uC2DC\uB4E4\uC774 \uB208\uC5D0 \uB4E4\uC5B4\uC624\uB294
      \uC21C\uAC04 \uC628\uBAB8\uC774 \uC5BC\uC5B4\uBD99\uC5C8\uB2E4. \uADF8\uB0E5
      \uD2C0\uB9B0 \uBB38\uC81C\uB4E4\uC778\uB370, \uC774\uC0C1\uD558\uAC8C \uADF8
      \uBE68\uAC04\uC0C9\uC774 \uB9C8\uCE58 \uD53C\uCC98\uB7FC \uD758\uB7EC\uB0B4\uB9AC\uB294
      \uAC83 \uAC19\uC558\uB2E4. \uB098\uB294 \uBA4D\uCCAD\uC774\uC778\uAC00\uBCF4\uB2E4.
      \uC774\uB7F0 \uBB38\uC81C\uB3C4 \uC81C\uB300\uB85C \uD480\uC9C0\uB3C4 \uBABB\uD558\uB294
      \uBA4D\uCCAD\uC774.."
    m_Metadata:
      m_Items: []
  - m_Id: 685654021
    m_Localized: "\uC544\uBC84\uC9C0\uAC00 \uC220\uC744 \uADF8\uB9CC \uB4DC\uC168\uC73C\uBA74
      \uC88B\uACA0\uB2E4. \uC220\uC774 \uB4E4\uC5B4\uAC00\uBA74 \uC131\uACA9\uC774
      \uB4A4\uBC14\uB00C\uC2E0\uB2E4. \uC220\uBCD1\uC744 \uC9D1\uC5B4 \uB358\uC9C0\uACE0
      \uD30C\uD3B8\uC774 \uC5EC\uAE30\uC800\uAE30 \uB0A0\uC544\uB2E4\uB2CC\uB2E4.
      \uC9C0\uC625\uC774\uB2E4..\uD56D\uC0C1 \uBAB8\uC744 \uC6C5\uD06C\uB9AC\uACE0
      \uC81C\uBC1C \uAFC8\uC774\uAE30\uB97C \uBC14\uB780\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 685654022
    m_Localized: "\uAFC8 \uC18D\uC5D0\uC11C, \uC544\uCE68 \uAD50\uC2E4\uC5D0 \uB4E4\uC5B4\uAC14\uB294\uB370,
      \uCC45\uC0C1\uB4E4\uC774 \uC5C9\uB9DD\uC73C\uB85C \uC5B4\uC9C0\uB7FD\uD600\uC838
      \uC788\uC5C8\uB2E4. \uB204\uAC00 \uC77C\uBD80\uB7EC \uB4A4\uC9D1\uC5B4 \uB193\uC740
      \uAC74\uC9C0, \uC5EC\uAE30\uC800\uAE30 \uD769\uC5B4\uC9C4 \uCC45\uB4E4\uACFC
      \uC758\uC790\uB4E4\uAE4C\uC9C0 \uC644\uC804 \uB09C\uC7A5\uD310\uC774\uC5C8\uB2E4.
      \uB2E4\uB4E4 \uB2F9\uD669\uD574\uC11C \uC6C5\uC131\uAC70\uB838\uC9C0\uB9CC,
      \uC815\uC791 \uB204\uAC00 \uADF8\uB7AC\uB294\uC9C0\uB294 \uC54C \uC218 \uC5C6\uC5C8\uB2E4.
      \uAD1C\uD788 \uBD88\uC548\uD55C \uAE30\uBD84\uC774 \uB4E4\uC5B4\uC11C \uB0B4\uAC00
      \uC549\uB294 \uC790\uB9AC\uB97C \uD55C \uBC88 \uB354 \uD655\uC778\uD588\uB2E4.
      \uADF8\uB9AC\uACE0 \uAFC8\uC5D0\uC11C \uAE7C\uB2E4. \uB108\uBB34 \uC0DD\uC0DD\uD574\uC11C
      \uD604\uC2E4 \uAC19\uC558\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 689848320
    m_Localized: "\uC624\uB298 \uC544\uCE68\uC5D0 \uC637\uAC78\uC774\uB97C \uBD24\uB294\uB370,
      \uAC78\uC5B4\uB454 \uC637 \uC0C9\uAE54\uC774 \uBC14\uB00C\uC5B4 \uC788\uC5C8\uC5B4.
      \uC5B4\uC81C\uB791 \uB2E4\uB974\uAC8C \uBCF4\uC774\uB294 \uAC8C \uC774\uC0C1\uD574\uC11C
      \uACC4\uC18D \uCCD0\uB2E4\uBD24\uB294\uB370, \uB0B4\uAC00 \uC798\uBABB \uBCF8
      \uAC74\uC9C0 \uBAA8\uB974\uACA0\uC5B4. \uC637\uC774 \uC65C \uBC14\uB010 \uAC74\uC9C0
      \uC0DD\uAC01\uD558\uBA74 \uC880 \uC774\uC0C1\uD558\uACE0 \uBB34\uC11C\uC6B4
      \uB290\uB08C\uC774 \uB4E4\uC5C8\uC5B4. \uB0B4\uC77C \uB2E4\uC2DC \uBCF4\uBA74
      \uC6D0\uB798\uB300\uB85C \uB3CC\uC544\uC640 \uC788\uC744\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 689848321
    m_Localized: "\uC637\uAC78\uC774\uB294 \uBB34\uC11C\uC6CC. \uC637\uC774 \uAC78\uB824\uC788\uB294
      \uAC78 \uBCF4\uBA74 \uB108\uBB34 \uC0AC\uB78C\uAC19\uC544.. \uCC28\uB77C\uB9AC
      \uC800 \uC637\uC744 \uB2E4 \uC5C6\uC560\uBC84\uB9AC\uB294\uAC8C \uB0AB\uC9C0
      \uC54A\uC744\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 689848322
    m_Localized: "\uAD50\uBCF5\uC744 \uBCF4\uB2C8, \uCE58\uC6B0\uC9C0 \uBABB\uD55C
      \uBC1C\uC790\uAD6D\uC774 \uADF8\uB300\uB85C \uB0A8\uC544 \uC788\uC5C8\uB2E4.
      \uC218\uC5C5 \uB05D\uB098\uACE0 \uBCF5\uB3C4\uC5D0\uC11C \uB204\uAD70\uAC00\uAC00
      \uC77C\uBD80\uB7EC \uBC00\uACE0 \uBC1F\uACE0 \uAC04 \uAC8C \uBD84\uBA85\uD55C\uB370,
      \uC544\uBB34 \uB9D0\uB3C4 \uBABB \uD55C \uB0B4\uAC00 \uB108\uBB34 \uD654\uAC00
      \uB0AC\uB2E4. \uBB3C\uB85C \uC9C0\uC6CC\uBCF4\uB824 \uD588\uC9C0\uB9CC, \uC790\uAD6D\uC740
      \uC27D\uAC8C \uC9C0\uC6CC\uC9C0\uC9C0 \uC54A\uC558\uB2E4. \uADF8 \uBC1C\uC790\uAD6D\uC774
      \uB9C8\uCE58 \uB0B4 \uC790\uC874\uC2EC \uC704\uC5D0 \uCC0D\uD78C \uAC83 \uAC19\uC544
      \uB354 \uACAC\uB514\uAE30 \uD798\uB4E4\uC5C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 689848323
    m_Localized: "\uC624\uB298 \uAFC8\uC5D0\uC11C \uC637\uAC78\uC774\uAC00 \uAC11\uC790\uAE30
      \uC0AC\uB78C\uCC98\uB7FC \uC6C0\uC9C1\uC600\uC5B4. \uD314\uC774 \uAE38\uC5B4\uC9C0\uB354\uB2C8
      \uB098\uB97C \uCAD3\uC544\uC624\uAE30 \uC2DC\uC791\uD588\uC5B4. \uB098\uB294
      \uC228\uC73C\uB824\uACE0 \uB6F0\uC5C8\uB294\uB370, \uC790\uAFB8 \uB4A4\uC5D0\uC11C
      \uB0A0 \uC7A1\uC73C\uB824\uACE0 \uC190\uC744 \uBED7\uC5C8\uC5B4. \uAD34\uBB3C\uC774
      \uB098\uB97C \uC8FD\uC774\uB824\uACE0 \uC18C\uB9AC\uCE58\uB294\uB370 \uB108\uBB34
      \uBB34\uC11C\uC6CC\uC11C \uC18C\uB9AC\uB3C4 \uBABB \uB0C8\uC5B4. \uAFC8\uC5D0\uC11C
      \uAE68\uACE0 \uB098\uB2C8\uAE4C \uC637\uAC78\uC774\uB97C \uB2E4\uC2DC \uBCF4\uAE30\uAC00
      \uC2EB\uC5B4\uC84C\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 689848324
    m_Localized: "\uC624\uB298 \uCEF4\uD4E8\uD130\uB85C \uBB58 \uD558\uB2E4\uAC00
      \uAC11\uC790\uAE30 \uD654\uBA74\uC774 \uC774\uC0C1\uD574\uC84C\uC5B4. \uD654\uBA74
      \uAC00\uB4DD \uC774\uC0C1\uD55C \uB178\uC774\uC988\uAC00 \uC0DD\uAE30\uB354\uB2C8,
      \uC544\uBB34\uAC83\uB3C4 \uBCF4\uC774\uC9C0 \uC54A\uC558\uC5B4. \uB9C8\uCE58
      \uB204\uAC00 \uC77C\uBD80\uB7EC \uB9DD\uAC00\uB728\uB9B0 \uAC83 \uAC19\uC544\uC11C
      \uC18C\uB984\uC774 \uB3CB\uC558\uC5B4. \uBA87 \uBC88 \uC7AC\uBD80\uD305\uD574\uB3C4
      \uB611\uAC19\uC544\uC11C \uADF8\uB0E5 \uC804\uC6D0\uC744 \uAEBC\uBC84\uB838\uC5B4.
      \uC774\uAC8C \uB2E8\uC21C\uD55C \uC624\uB958\uC77C\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 689848325
    m_Localized: "\uC624\uB298 \uBC24\uC5D0 \uAC8C\uC784\uC744 \uD558\uACE0 \uC788\uC5C8\uB294\uB370,
      \uAC11\uC790\uAE30 \uD654\uBA74\uC5D0 \uADC0\uC2E0 \uAC19\uC740 \uAC8C \uD280\uC5B4\uB098\uC654\uB2E4.
      \uC6D0\uB798 \uADF8\uB7F0 \uAC8C\uC784\uC774 \uC544\uB2C8\uC5C8\uB294\uB370,
      \uBB54\uAC00 \uC624\uB958\uB77C\uB3C4 \uB09C \uAC74\uC9C0 \uC18C\uB984 \uB07C\uCE58\uB294
      \uC5BC\uAD74\uC774 \uB531 \uB098\uD0C0\uB09C \uAC70\uC57C. \uC21C\uAC04 \uB108\uBB34
      \uB180\uB77C\uC11C \uB9C8\uC6B0\uC2A4\uB97C \uB5A8\uC5B4\uB728\uB838\uB294\uB370,
      \uADF8 \uB4A4\uB85C \uD654\uBA74\uC774 \uC544\uC608 \uBA48\uCDB0\uBC84\uB838\uB2E4.
      \uC774\uAC8C \uC9C4\uC9DC \uBC84\uADF8\uC778\uC9C0, \uC544\uB2C8\uBA74 \uB204\uAC00
      \uC7A5\uB09C\uCE5C \uAC74\uC9C0 \uBAA8\uB974\uACA0\uB294\uB370, \uB2E4\uC2DC
      \uCF1C\uAE30\uAC00 \uBB34\uC12D\uB2E4. \uAC8C\uC784\uC740 \uC7A0\uAE50 \uC26C\uB294
      \uAC8C \uC88B\uC744 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 689848326
    m_Localized: "\uC624\uB298 \uCEF4\uD4E8\uD130\uAC00 \uAC11\uC790\uAE30 \uAEBC\uC838
      \uBC84\uB838\uB2E4. \uC804\uAE30\uB3C4 \uBA40\uCA61\uD588\uB294\uB370, \uAC11\uC790\uAE30
      \uD654\uBA74\uC774 \uBA39\uD1B5\uC774 \uB418\uB294 \uBC14\uB78C\uC5D0 \uB2F9\uD669\uD588\uB2E4.
      \uC911\uC694\uD55C \uC219\uC81C \uC911\uC774\uC5C8\uB294\uB370, \uB2E4 \uB0A0\uC544\uAC04
      \uAC74 \uC544\uB2CC\uC9C0 \uAC71\uC815\uB3FC\uC11C \uC9C4\uC9DC \uBBF8\uCE60
      \uBED4 \uD588\uB2E4. \uBA87 \uBC88 \uC804\uC6D0\uC744 \uB20C\uB7EC\uBD24\uC9C0\uB9CC
      \uBC18\uC751\uC774 \uC5C6\uC5B4\uC11C \uADF8\uB0E5 \uD3EC\uAE30\uD588\uB2E4.
      \uB300\uCCB4 \uC65C \uC774\uB7EC\uB294 \uAC74\uC9C0 \uBAA8\uB974\uACA0\uB294\uB370,
      \uC774\uB7F0 \uC77C\uC774 \uB610 \uC0DD\uAE30\uBA74 \uC815\uB9D0 \uC2A4\uD2B8\uB808\uC2A4
      \uBC1B\uC744 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 694042624
    m_Localized: "\uC624\uB298 \uBC24 \uCC3D\uBB38 \uBC16\uC744 \uBD24\uB2E4\uAC00
      \uC9C4\uC9DC \uC774\uC0C1\uD55C \uAC78 \uBD24\uB2E4. \uADC0\uC2E0\uCC98\uB7FC
      \uC0DD\uAE34 \uBB54\uAC00\uAC00 \uCC3D\uBB38 \uB108\uBA38\uB85C \uB5A8\uC5B4\uC9C0\uB294
      \uAC8C \uBCF4\uC778 \uAC70\uB2E4. \uC21C\uAC04 \uC2EC\uC7A5\uC774 \uCCA0\uB801\uD588\uC9C0\uB9CC,
      \uB108\uBB34 \uBE68\uB77C\uC11C \uD655\uC2E4\uD788 \uBCF8 \uAC74\uC9C0\uB3C4
      \uBAA8\uB974\uACA0\uC5B4. \uADF8\uB0E5 \uB0B4\uAC00 \uCC29\uAC01\uD55C \uAC70\uACA0\uC9C0
      \uC2F6\uC73C\uBA74\uC11C\uB3C4 \uC790\uAFB8 \uADF8 \uC7A5\uBA74\uC774 \uB5A0\uC624\uB978\uB2E4.
      \uCC3D\uBB38\uC744 \uB2EB\uACE0 \uCEE4\uD2BC\uC744 \uCCE4\uB294\uB370, \uC544\uC9C1\uB3C4
      \uC774\uC0C1\uD55C \uAE30\uBD84\uC774 \uAC00\uC2DC\uC9C8 \uC54A\uB294\uB2E4.
      \uC774\uB7F0 \uAE30\uBD84\uC73C\uB85C\uB294 \uC7A0\uB3C4 \uC624\uC9C8 \uC54A\uB294\uB2E4.."
    m_Metadata:
      m_Items: []
  - m_Id: 694042625
    m_Localized: "\uC624\uB298 \uB4F1\uAD50\uD588\uC744 \uB54C \uAD6D\uD654\uAC00
      \uB0B4 \uC790\uB9AC \uC704\uC5D0 \uC62C\uB824\uC838 \uC788\uC5C8\uB2E4. \uBB50\uC9C0?
      \uB098\uB294 \uC544\uC9C1 \uC0B4\uC544\uC788\uB294\uB370 \uB204\uAC00 \uC774\uB7F0
      \uC7A5\uB09C\uC744 \uD55C \uAC83\uC77C\uAE4C? \uD56D\uC758\uB77C\uB3C4 \uD558\uB4EF
      \uC8FC\uBCC0\uC5D0 \uC788\uB294 \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C \uC18C\uB9AC\uCCE4\uB2E4.
      \uD558\uC9C0\uB9CC \uADF8 \uB204\uAD6C\uB3C4 \uB098\uC758 \uBAA9\uC18C\uB9AC\uB97C
      \uB4E3\uC9C0 \uBABB\uD558\uB294 \uAC83 \uAC19\uC558\uB2E4. \uB0B4\uAC00 \uC815\uB9D0\uB85C
      \uC8FD\uC740 \uAC83\uC774\uC5C8\uB098? \uC2DD\uC740\uB540\uC774 \uB4F1\uC5D0\uC11C
      \uD758\uB7EC\uB0B4\uB9B4 \uB54C \uCBE4, \uC54C\uB78C\uC18C\uB9AC\uC5D0 \uB208\uC774
      \uB5A0\uC84C\uB2E4. \uC9C0\uB3C5\uD55C \uC545\uBABD\uC774\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 694042626
    m_Localized: "\uC624\uB298 \uC9D1\uC5D0 \uC640\uC11C \uAC00\uBC29\uC744 \uB480\uB294\uB370,
      \uADF8 \uBB34\uAC70\uC6B4 \uAC00\uBC29\uC774 \uACB0\uAD6D \uD130\uC9C0\uB4EF
      \uC3DF\uC544\uC84C\uB2E4. \uAD50\uACFC\uC11C\uB4E4\uC774 \uBC14\uB2E5\uC5D0
      \uC640\uB974\uB974 \uD769\uC5B4\uC9C0\uBA74\uC11C \uCC45\uC7A5 \uBA87 \uAC1C\uAC00
      \uCC22\uC5B4\uC9C4 \uAC78 \uBCF4\uB2C8 \uD55C\uC228\uC774 \uB098\uC654\uB2E4.
      \uC774\uB807\uAC8C \uAC00\uBC29\uC774 \uD130\uC9C8 \uB9CC\uD07C \uCC45\uC744
      \uB4E4\uACE0 \uB2E4\uB140\uC57C \uD55C\uB2E4\uB2C8, \uC65C \uC774\uB7F0 \uAC74\uC9C0
      \uBAA8\uB974\uACA0\uB2E4. \uBC14\uB2E5\uC5D0 \uB110\uB9B0 \uAD50\uACFC\uC11C\uB97C
      \uC8FC\uC6B0\uBA74\uC11C, \uB0B4\uC77C\uC740 \uAC00\uBC29 \uC548\uC744 \uC880
      \uC815\uB9AC\uD574\uC57C\uACA0\uB2E4\uACE0 \uC0DD\uAC01\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 694042627
    m_Localized: "\uCE5C\uAD6C\uB4E4\uACFC \uD589\uB9E8 \uAC8C\uC784\uC744 \uD588\uB2E4.
      \uCE5C\uAD6C\uAC00 \uB0B8 \uB2E8\uC5B4\uAC00 \uB3C4\uBB34\uC9C0 \uB9DE\uCD9C
      \uC218 \uAC00 \uC5C6\uB294 \uB2E8\uC5B4\uC600\uB2E4. \uD589\uB9E8\uC740 \uC0AC\uD615\uB300\uC5D0
      \uC0AC\uB78C\uC774 \uBB36\uC5EC\uC11C \uC8FD\uAE30 \uC804\uC5D0 \uB2E8\uC5B4\uB97C
      \uB9DE\uCDB0\uC57C \uD55C\uB2E4. \uD558\uC9C0\uB9CC \uADF8 \uB2E8\uC5B4\uB294
      \uB3C4\uBB34\uC9C0 \uB0B4\uAC00 \uC54C \uC218\uAC00 \uC5C6\uB358 \uB2E8\uC5B4\uC600\uB2E4.
      \uB0B4\uAE30\uC5D0\uC11C \uC9C4 \uB098\uB294 \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C
      \uB5A1\uBCF6\uC774\uB97C \uC0AC\uC918\uC57C \uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 694042628
    m_Localized: "\uC624\uB298 \uCC45\uC0C1\uC5D0 \uC549\uC544\uC11C \uC219\uC81C\uB97C
      \uBCF4\uB294\uB370, \uC0B0\uB354\uBBF8\uCC98\uB7FC \uC313\uC5EC \uC788\uB294
      \uAC78 \uBCF4\uACE0 \uD55C\uC228\uBD80\uD130 \uB098\uC654\uB2E4. \uC5B8\uC81C
      \uC774\uB807\uAC8C \uB9CE\uC544\uC84C\uB294\uC9C0 \uBAA8\uB974\uACA0\uC9C0\uB9CC,
      \uC5B4\uB514\uC11C \uBD80\uD130 \uC190\uB300\uC57C \uD560\uC9C0\uB3C4 \uAC10\uC774
      \uC548 \uC628\uB2E4. \uD558\uBA74 \uD560\uC218\uB85D \uB05D\uC774 \uC548 \uBCF4\uC5EC\uC11C
      \uBA38\uB9AC\uAC00 \uD130\uC9C8 \uAC83 \uAC19\uB2E4. \uACFC\uC5F0 \uC774\uAC78
      \uB2E4 \uB05D\uB0B4\uACE0 \uB0B4\uC77C\uC744 \uB9DE\uC774\uD560 \uC218 \uC788\uC744\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 694042629
    m_Localized: "\uC624\uB298 \uBC29\uC5D0 \uD63C\uC790 \uC788\uB294\uB370 \uAC11\uC790\uAE30
      \uC804\uAD6C\uAC00 \uAE5C\uBE61\uAC70\uB9AC\uAE30 \uC2DC\uC791\uD588\uB2E4.
      \uCC98\uC74C\uC5D4 \uADF8\uB0E5 \uC804\uAD6C \uC218\uBA85\uC774 \uB2E4 \uB41C
      \uAC74\uAC00 \uC2F6\uC5C8\uB294\uB370, \uAE5C\uBE61\uC774\uB294 \uC18D\uB3C4\uAC00
      \uC810\uC810 \uBE68\uB77C\uC9C0\uB294 \uAC8C \uC774\uC0C1\uD588\uB2E4. \uADF8\uB7EC\uB2E4
      \uD55C\uC21C\uAC04 \uBD88\uC774 \uAEBC\uC84C\uB2E4\uAC00 \uB2E4\uC2DC \uCF1C\uC84C\uB294\uB370,
      \uADF8 \uC21C\uAC04 \uBC29\uC774 \uB108\uBB34 \uC870\uC6A9\uD574\uC11C \uC624\uD788\uB824
      \uB354 \uBB34\uC12D\uAC8C \uB290\uAEF4\uC84C\uB2E4. \uADF8\uB0E5 \uC804\uAD6C
      \uBB38\uC81C\uC77C \uAC70\uB77C \uC0DD\uAC01\uD558\uB824 \uD588\uC9C0\uB9CC,
      \uC774\uC0C1\uD558\uAC8C \uCC1D\uCC1D\uD55C \uAE30\uBD84\uC774 \uAC00\uC2DC\uC9C8
      \uC54A\uB294\uB2E4. \uB0B4\uC77C \uC804\uAD6C\uB97C \uAF2D \uAC08\uC544\uC57C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 694042630
    m_Localized: "\uC624\uB298\uC740 \uD3C9\uC18C\uCC98\uB7FC PC\uBC29\uC5D0\uC11C
      \uAC8C\uC784\uC744 \uD558\uACE0 \uC788\uC5C8\uB294\uB370, \uAC11\uC790\uAE30
      \uD654\uBA74\uC774 \uC774\uC0C1\uD558\uAC8C \uBC14\uB00C\uC5C8\uB2E4. \uCC98\uC74C\uC5D4
      \uB809\uC778 \uC904 \uC54C\uC558\uB294\uB370, \uB2E4\uB978 \uC88C\uC11D\uC5D0\uC11C\uB3C4
      \uB204\uAC00 \u201C\uC57C \uB108\uB3C4 \uC774\uAC70 \uBD10\uBD10\u201D \uD558\uB354\uB77C.
      \uB2E4\uB4E4 \uAC8C\uC784 \uD654\uBA74\uC774 \uBA4B\uB300\uB85C \uBC14\uB00C\uAC70\uB098
      \uBA48\uCDB0 \uC788\uC5C8\uB2E4. \uC2EC\uC9C0\uC5B4 \uAC8C\uC784\uC774 \uAEBC\uC838\uB3C4
      \uBC30\uACBD\uC74C\uC774 \uC774\uC5B4\uC9C0\uB294 \uC790\uB9AC\uB3C4 \uC788\uC5C8\uB2E4.
      \uC54C\uBC14\uAC00 \uC11C\uBC84 \uBB38\uC81C\uC778 \uAC83 \uAC19\uB2E4\uACE0
      \uD588\uB2E4. \uC5F0\uC2B9 \uC911\uC774\uC5C8\uB294\uB370."
    m_Metadata:
      m_Items: []
  - m_Id: 694042631
    m_Localized: "\uC624\uB298\uC740 \uC720\uB09C\uD788 \uD55C\uC0B0\uD55C \uB0A0\uC774\uC5C8\uB2E4.
      \uB2E4\uB978 \uC190\uB2D8\uB4E4\uC774 \uD558\uB098\uB458 \uB098\uAC00\uACE0,
      \uC54C\uBC14\uB3C4 \uC7A0\uAE50 \uD654\uC7A5\uC2E4\uC744 \uAC14\uB294\uC9C0
      \uC790\uB9AC\uB97C \uBE44\uC6E0\uB2E4. \uADF8 \uB113\uC740 PC\uBC29\uC5D0 \uB098
      \uD63C\uC790 \uC549\uC544 \uC788\uB294 \uAC8C \uBB18\uD558\uAC8C \uBD88\uC548\uD588\uB2E4.
      \uC591 \uC606\uC5D0\uB294 \uCE58\uC6CC\uC9C0\uC9C0 \uC54A\uC740 \uCEF5\uB77C\uBA74
      \uC6A9\uAE30, \uACFC\uC790 \uBD09\uC9C0\uAC00 \uB098\uB4B9\uAD74\uACE0 \uC788\uC5C8\uACE0,
      \uD658\uD48D\uAE30 \uC18C\uB9AC\uB9CC \uC6B8\uB838\uB2E4. \uAC8C\uC784 \uC18C\uB9AC\uB3C4
      \uC904\uC600\uB294\uB370, \uC870\uC6A9\uD55C \uAC8C \uC624\uD788\uB824 \uBB18\uD55C
      \uAE30\uBD84\uC774 \uB4E4\uC5C8\uB2E4. \uC2DC\uB044\uB7EC\uC6E0\uB358 \uACF3\uC774
      \uC870\uC6A9\uD574\uC9C0\uB2C8\uAE4C \uB354 \uADF8\uB807\uB2E4.\r"
    m_Metadata:
      m_Items: []
  - m_Id: 694042632
    m_Localized: "\uC624\uB298 \uD559\uAD50\uC5D0\uC11C \uAC11\uC790\uAE30 \uC2A4\uD53C\uCEE4\uC5D0\uC11C
      \uC774\uC0C1\uD55C \uC18C\uB9AC\uAC00 \uC6B8\uB838\uB2E4. \uBB54\uAC00 \uC6C5\uC6C5\uAC70\uB9AC\uB294
      \uC18C\uB9AC \uAC19\uC558\uB294\uB370, \uC544\uBB34 \uB9D0\uB3C4 \uC5C6\uC774
      \uACC4\uC18D \uC6B8\uB9AC\uAE30\uB9CC \uD574\uC11C \uBAA8\uB450\uAC00 \uC5B4\uB9AC\uB465\uC808\uD588\uB2E4.
      \uC120\uC0DD\uB2D8\uB3C4 \uC774\uC720\uB97C \uBAA8\uB974\uACA0\uB2E4\uBA70
      \uAD50\uBB34\uC2E4\uB85C \uAC00\uC168\uACE0, \uAD50\uC2E4\uC740 \uBB18\uD55C
      \uAE34\uC7A5\uAC10\uC774 \uAC10\uB3CC\uC558\uB2E4. \uC18C\uB9AC\uB294 \uBA87
      \uBD84 \uB4A4\uC5D0 \uBA48\uCDC4\uC9C0\uB9CC, \uC774\uC0C1\uD558\uAC8C \uBD88\uC548\uD55C
      \uAE30\uBD84\uC774 \uB4E4\uC5C8\uB2E4. \uB0B4\uAC00 \uBBF8\uCCD0\uAC00\uB294
      \uAC78\uAE4C. "
    m_Metadata:
      m_Items: []
  - m_Id: 694042633
    m_Localized: "\uC624\uB298 \uBC29\uC5D0\uC11C \uACF5\uBD80\uD558\uB2E4\uAC00
      \uC774\uC0C1\uD55C \uAC78 \uBC1C\uACAC\uD588\uB2E4. \uBD84\uBA85 \uB0B4\uAC00
      \uB2EB\uC544\uB454 \uCC3D\uBB38\uC774 \uC5B4\uB290\uC0C8 \uC5F4\uB824 \uC788\uB294
      \uAC70\uB2E4. \uBC14\uB78C\uC774 \uBD88\uC5B4\uB3C4 \uC5F4\uB9B4 \uC77C\uC774
      \uC5C6\uC744 \uD150\uB370, \uC21C\uAC04 \uC18C\uB984\uC774 \uD655 \uB3CB\uC558\uB2E4.
      \uD639\uC2DC \uB0B4\uAC00 \uAE5C\uBE61\uD558\uACE0 \uC548 \uB2EB\uC740 \uAC74\uAC00
      \uC2F6\uC5B4 \uAE30\uC5B5\uC744 \uB418\uC9DA\uC5B4\uBD24\uC9C0\uB9CC, \uD655\uC2E4\uD788
      \uB2EB\uC740 \uAC8C \uB9DE\uB2E4. \uAD1C\uD788 \uB4A4\uC5D0\uC11C \uB204\uAC00
      \uC9C0\uCF1C\uBCF4\uACE0 \uC788\uB294 \uAC83 \uAC19\uC544 \uCC3D\uBB38\uC744
      \uB2E4\uC2DC \uB2EB\uACE0 \uCEE4\uD2BC\uAE4C\uC9C0 \uCCE4\uB2E4. \uC774\uC0C1\uD55C
      \uC77C\uC774 \uACC4\uC18D \uC0DD\uAE30\uBA74 \uC815\uB9D0 \uC2E0\uACBD \uC4F0\uC77C
      \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 694042634
    m_Localized: "\uADF8\uB0A0\uC740 \uD3C9\uC18C\uCC98\uB7FC \uC77C\uACFC \uB05D\uB098\uACE0
      \uC810\uD638 \uC900\uBE44\uB97C \uD558\uACE0 \uC788\uC5C8\uB2E4. \uCE68\uC0C1\uC744
      \uCCAD\uC18C\uD558\uB2E4\uAC00 \uC606 \uAD00\uBB3C\uB300 \uBB38\uC774 \uC5F4\uB838\uB294\uB370,
      \uC548\uC5D0\uC11C \uBB34\uC5B8\uAC00\uAC00 \uB610\uB974\uB974 \uAD74\uB7EC\uB098\uC654\uB2E4.
      \uCC98\uC74C\uC5D4 \uADF8\uB0E5 \uAC1C\uC778\uBB3C\uD488\uC778 \uC904 \uC54C\uC558\uC9C0\uB9CC,
      \uADF8\uAC74 \uCD1D\uC54C\uC9D1\uC774\uC5C8\uB2E4. \uC21C\uAC04 \uC190\uC774
      \uC5BC\uC5B4\uBD99\uC5C8\uB2E4. \uB354 \uB180\uB77C\uC6B4 \uAC74, \uBC14\uB85C
      \uC606\uCE78\uC5D0 \uC788\uB358 \uB3D9\uAE30\uC758 \uAD00\uBB3C\uB300\uC5D0\uC11C\uB3C4
      \uC218\uB958\uD0C4 \uD558\uB098\uAC00 \uB098\uC628 \uAC70\uB2E4. \uD6C8\uB828\uC6A9
      \uD45C\uC2DD\uB3C4 \uC5C6\uACE0, \uC2E4\uBB3C\uCC98\uB7FC \uBCF4\uC600\uB2E4.
      \uADF8 \uC790\uB9AC\uC5D0\uC11C \uBC14\uB85C \uB2F9\uC9C1\uC0AC\uAD00\uC744
      \uBD88\uB800\uACE0, \uC0C1\uD669\uC740 \uC704\uB85C \uC62C\uB77C\uAC14\uB2E4.
      \uC0AC\uAC74\uC740 \uC870\uC6A9\uD788 \uB36E\uC600\uC9C0\uB9CC, \uB9CC\uC57D
      \uC6B0\uB9AC\uAC00 \uC5F4\uC5B4\uBCF4\uC9C0 \uC54A\uC558\uB2E4\uBA74\u2026
      \uC0C1\uC0C1\uB9CC \uD574\uB3C4 \uC2DD\uC740\uB540\uC774 \uB09C\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 694042635
    m_Localized: "\uAC70\uC6B8 \uC55E\uC5D0 \uC549\uC544 \uBC14\uB9AC\uAE61 \uC18C\uB9AC\uB97C
      \uB4E4\uC73C\uBA70 \uBA38\uB9AC\uCE74\uB77D\uC774 \uC6B0\uC218\uC218 \uB5A8\uC5B4\uC84C\uB2E4.
      \uC9E7\uC544\uC9C4 \uBA38\uB9AC\uCE74\uB77D\uC774 \uBC14\uB2E5\uC744 \uB36E\uC744\uC218\uB85D
      \uB9C8\uC74C \uD55C\uAD6C\uC11D\uC774 \uBB18\uD558\uAC8C \uD5C8\uC804\uD574\uC84C\uB2E4.
      \uC6C3\uC73C\uBA70 \uC7A5\uB09C\uCE58\uB294 \uCE5C\uAD6C\uB4E4\uC758 \uBAA9\uC18C\uB9AC\uAC00
      \uB4E4\uB9AC\uC9C0\uB9CC, \uAC70\uC6B8 \uC18D \uB0B4 \uC5BC\uAD74\uC740 \uC5B4\uB518\uAC00
      \uB0AF\uC124\uB2E4. \uC190\uC73C\uB85C \uC9E7\uC544\uC9C4 \uBA38\uB9AC\uB97C
      \uC4F8\uC5B4\uBCF4\uB2E4\uAC00 \uAC11\uC790\uAE30 \uD604\uC2E4\uAC10\uC774
      \uD655 \uBAB0\uB824\uC654\uB2E4. \uC624\uB298\uBD80\uD130 2\uB144.. \uBB34\uC12D\uACE0,
      \uAE34\uC7A5\uB41C\uB2E4. \uC544\uAE4C \uBA39\uC740 \uC810\uC2EC\uC774 \uCCB4\uD55C
      \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 698236928
    m_Localized: "\uADC0\uB97C \uCC22\uB294 \uB4EF\uD55C \uB098\uD314 \uC18C\uB9AC\uAC00
      \uACF5\uAE30\uB97C \uAC00\uB974\uBA70 \uB4E4\uB824\uC628\uB2E4. \uAE4A\uAC8C
      \uC7A0\uB4E4\uC5B4 \uC788\uB358 \uBAB8\uC774 \uAC15\uC81C\uB85C \uB04C\uC5B4
      \uC62C\uB824\uC9C0\uB294 \uB290\uB08C\uC774\uC5C8\uB2E4. \uBA38\uB9BF\uC18D\uC740
      \uC544\uC9C1 \uD63C\uB780\uC2A4\uB7EC\uC6B4\uB370, \uC628\uBAB8\uC740 \uC774\uBBF8
      \uBC18\uC0AC\uC801\uC73C\uB85C \uC6C0\uC9C1\uC774\uACE0 \uC788\uC5C8\uB2E4.
      \uC18C\uB9AC\uAC00 \uBA48\uCDC4\uC9C0\uB9CC \uADF8 \uC794\uD5A5\uC774 \uBA38\uB9BF\uC18D\uC5D0
      \uB9F4\uB3CC\uBA70 \uBD88\uC548\uAC10\uC744 \uB354\uD588\uB2E4. \uC5B8\uC81C\uCBE4
      \uC0AC\uD68C\uC5D0 \uC775\uC219\uD574\uC9C8\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 698236929
    m_Localized: "\uBC29 \uD55C\uAD6C\uC11D\uC5D0\uC11C \uBB34\uC5B8\uAC00 \uC6C0\uC9C1\uC774\uB294
      \uAC8C \uBCF4\uC600\uB2E4. \uCC98\uC74C\uC5D4 \uCC29\uAC01\uC778 \uC904 \uC54C\uC558\uB294\uB370,
      \uB208\uC55E\uC5D0 \uD655\uC2E4\uD788 \uBC8C\uB808\uAC00 \uAE30\uC5B4\uAC00\uACE0
      \uC788\uC5C8\uB2E4. \uC21C\uAC04\uC801\uC73C\uB85C \uBAB8\uC774 \uAD73\uC5C8\uACE0,
      \uB098\uB3C4 \uBAA8\uB974\uAC8C \uB4B7\uAC78\uC74C\uC9C8\uCCE4\uB2E4. \uC5B4\uB514\uC11C
      \uB098\uC628 \uAC74\uC9C0 \uC0DD\uAC01\uD560\uC218\uB85D \uC18C\uB984\uC774
      \uB3CB\uACE0, \uBC29 \uC804\uCCB4\uAC00 \uAC11\uC790\uAE30 \uB0AF\uC124\uACE0
      \uBD88\uD3B8\uD558\uAC8C \uB290\uAEF4\uC84C\uB2E4. \uD558\uB098\uAC00 \uBCF4\uC774\uBA74
      \uC9D1 \uC804\uCCB4\uAC00 \uC774\uBBF8 \uC800\uB4E4\uC758 \uC18C\uAD74\uC774\uB77C\uACE0
      \uD55C\uB2E4. \uB09C \uB9DD\uD588\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 698236930
    m_Localized: "\uC624\uB298 \uC544\uCE68\uC5D0 \uC637\uAC78\uC774\uB97C \uBD24\uB294\uB370,
      \uAC78\uC5B4\uB454 \uC637 \uC0C9\uAE54\uC774 \uBC14\uB00C\uC5B4 \uC788\uC5C8\uC5B4.
      \uC5B4\uC81C\uB791 \uB2E4\uB974\uAC8C \uBCF4\uC774\uB294 \uAC8C \uC774\uC0C1\uD574\uC11C
      \uACC4\uC18D \uCCD0\uB2E4\uBD24\uB294\uB370, \uB0B4\uAC00 \uC798\uBABB \uBCF8
      \uAC74\uC9C0 \uBAA8\uB974\uACA0\uC5B4. \uC637\uC774 \uC65C \uBC14\uB010 \uAC74\uC9C0
      \uC0DD\uAC01\uD558\uBA74 \uC880 \uC774\uC0C1\uD558\uACE0 \uBB34\uC11C\uC6B4
      \uB290\uB08C\uC774 \uB4E4\uC5C8\uC5B4. \uB0B4\uC77C \uB2E4\uC2DC \uBCF4\uBA74
      \uC6D0\uB798\uB300\uB85C \uB3CC\uC544\uC640 \uC788\uC744\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 698236931
    m_Localized: "\uC637\uAC78\uC774\uB294 \uBB34\uC11C\uC6CC. \uC637\uC774 \uAC78\uB824\uC788\uB294
      \uAC78 \uBCF4\uBA74 \uB108\uBB34 \uC0AC\uB78C\uAC19\uC544.. \uCC28\uB77C\uB9AC
      \uC800 \uC637\uC744 \uB2E4 \uC5C6\uC560\uBC84\uB9AC\uB294\uAC8C \uB0AB\uC9C0
      \uC54A\uC744\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 698236932
    m_Localized: "\uAD50\uBCF5\uC744 \uBCF4\uB2C8, \uCE58\uC6B0\uC9C0 \uBABB\uD55C
      \uBC1C\uC790\uAD6D\uC774 \uADF8\uB300\uB85C \uB0A8\uC544 \uC788\uC5C8\uB2E4.
      \uC218\uC5C5 \uB05D\uB098\uACE0 \uBCF5\uB3C4\uC5D0\uC11C \uB204\uAD70\uAC00\uAC00
      \uC77C\uBD80\uB7EC \uBC00\uACE0 \uBC1F\uACE0 \uAC04 \uAC8C \uBD84\uBA85\uD55C\uB370,
      \uC544\uBB34 \uB9D0\uB3C4 \uBABB \uD55C \uB0B4\uAC00 \uB108\uBB34 \uD654\uAC00
      \uB0AC\uB2E4. \uBB3C\uB85C \uC9C0\uC6CC\uBCF4\uB824 \uD588\uC9C0\uB9CC, \uC790\uAD6D\uC740
      \uC27D\uAC8C \uC9C0\uC6CC\uC9C0\uC9C0 \uC54A\uC558\uB2E4. \uADF8 \uBC1C\uC790\uAD6D\uC774
      \uB9C8\uCE58 \uB0B4 \uC790\uC874\uC2EC \uC704\uC5D0 \uCC0D\uD78C \uAC83 \uAC19\uC544
      \uB354 \uACAC\uB514\uAE30 \uD798\uB4E4\uC5C8\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 702431232
    m_Localized: "\uC624\uB298 \uAFC8\uC5D0\uC11C \uC637\uAC78\uC774\uAC00 \uAC11\uC790\uAE30
      \uC0AC\uB78C\uCC98\uB7FC \uC6C0\uC9C1\uC600\uC5B4. \uD314\uC774 \uAE38\uC5B4\uC9C0\uB354\uB2C8
      \uB098\uB97C \uCAD3\uC544\uC624\uAE30 \uC2DC\uC791\uD588\uC5B4. \uB098\uB294
      \uC228\uC73C\uB824\uACE0 \uB6F0\uC5C8\uB294\uB370, \uC790\uAFB8 \uB4A4\uC5D0\uC11C
      \uB0A0 \uC7A1\uC73C\uB824\uACE0 \uC190\uC744 \uBED7\uC5C8\uC5B4. \uAD34\uBB3C\uC774
      \uB098\uB97C \uC8FD\uC774\uB824\uACE0 \uC18C\uB9AC\uCE58\uB294\uB370 \uB108\uBB34
      \uBB34\uC11C\uC6CC\uC11C \uC18C\uB9AC\uB3C4 \uBABB \uB0C8\uC5B4. \uAFC8\uC5D0\uC11C
      \uAE68\uACE0 \uB098\uB2C8\uAE4C \uC637\uAC78\uC774\uB97C \uB2E4\uC2DC \uBCF4\uAE30\uAC00
      \uC2EB\uC5B4\uC84C\uC5B4."
    m_Metadata:
      m_Items: []
  - m_Id: 702431233
    m_Localized: "\uCEF4\uD4E8\uD130 \uD654\uBA74\uC774 \uAC11\uC790\uAE30 \uD30C\uB797\uAC8C
      \uBB3C\uB4E4\uC5C8\uB2E4. \uC544\uBB34 \uAE00\uC790\uB3C4, \uADF8\uB9BC\uB3C4
      \uBCF4\uC774\uC9C0 \uC54A\uB294 \uD145 \uBE48 \uD30C\uB780\uBE5B\uC774 \uAC00\uB4DD\uD588\uB2E4.
      \uC190\uC744 \uC6C0\uC9C1\uC5EC\uB3C4, \uBC84\uD2BC\uC744 \uB20C\uB7EC\uB3C4
      \uC544\uBB34 \uBCC0\uD654\uB3C4 \uC5C6\uC5C8\uB2E4.  \uC800\uC7A5\uC740 \uD588\uB358\uAC00?
      \uC815\uB9D0 \uC544\uBB34\uAC83\uB3C4 \uD558\uAE30 \uC2EB\uB2E4. \uB05D\uC5C6\uB294
      \uC808\uB9DD\uAC10\uC774 \uB098\uB97C \uC9D3\uB204\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 702431234
    m_Localized: "\uC624\uB298 \uCEF4\uD4E8\uD130\uB85C \uBB58 \uD558\uB2E4\uAC00
      \uAC11\uC790\uAE30 \uD654\uBA74\uC774 \uC774\uC0C1\uD574\uC84C\uC5B4. \uD654\uBA74
      \uAC00\uB4DD \uC774\uC0C1\uD55C \uB178\uC774\uC988\uAC00 \uC0DD\uAE30\uB354\uB2C8,
      \uC544\uBB34\uAC83\uB3C4 \uBCF4\uC774\uC9C0 \uC54A\uC558\uC5B4. \uB9C8\uCE58
      \uB204\uAC00 \uC77C\uBD80\uB7EC \uB9DD\uAC00\uB728\uB9B0 \uAC83 \uAC19\uC544\uC11C
      \uC18C\uB984\uC774 \uB3CB\uC558\uC5B4. \uBA87 \uBC88 \uC7AC\uBD80\uD305\uD574\uB3C4
      \uB611\uAC19\uC544\uC11C \uADF8\uB0E5 \uC804\uC6D0\uC744 \uAEBC\uBC84\uB838\uC5B4.
      \uC774\uAC8C \uB2E8\uC21C\uD55C \uC624\uB958\uC77C\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 702431235
    m_Localized: "\uC624\uB298 \uBC24\uC5D0 \uAC8C\uC784\uC744 \uD558\uACE0 \uC788\uC5C8\uB294\uB370,
      \uAC11\uC790\uAE30 \uD654\uBA74\uC5D0 \uADC0\uC2E0 \uAC19\uC740 \uAC8C \uD280\uC5B4\uB098\uC654\uB2E4.
      \uC6D0\uB798 \uADF8\uB7F0 \uAC8C\uC784\uC774 \uC544\uB2C8\uC5C8\uB294\uB370,
      \uBB54\uAC00 \uC624\uB958\uB77C\uB3C4 \uB09C \uAC74\uC9C0 \uC18C\uB984 \uB07C\uCE58\uB294
      \uC5BC\uAD74\uC774 \uB531 \uB098\uD0C0\uB09C \uAC70\uC57C. \uC21C\uAC04 \uB108\uBB34
      \uB180\uB77C\uC11C \uB9C8\uC6B0\uC2A4\uB97C \uB5A8\uC5B4\uB728\uB838\uB294\uB370,
      \uADF8 \uB4A4\uB85C \uD654\uBA74\uC774 \uC544\uC608 \uBA48\uCDB0\uBC84\uB838\uB2E4.
      \uC774\uAC8C \uC9C4\uC9DC \uBC84\uADF8\uC778\uC9C0, \uC544\uB2C8\uBA74 \uB204\uAC00
      \uC7A5\uB09C\uCE5C \uAC74\uC9C0 \uBAA8\uB974\uACA0\uB294\uB370, \uB2E4\uC2DC
      \uCF1C\uAE30\uAC00 \uBB34\uC12D\uB2E4. \uAC8C\uC784\uC740 \uC7A0\uAE50 \uC26C\uB294
      \uAC8C \uC88B\uC744 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 702431236
    m_Localized: "\uC624\uB298 \uCEF4\uD4E8\uD130\uAC00 \uAC11\uC790\uAE30 \uAEBC\uC838
      \uBC84\uB838\uB2E4. \uC804\uAE30\uB3C4 \uBA40\uCA61\uD588\uB294\uB370, \uAC11\uC790\uAE30
      \uD654\uBA74\uC774 \uBA39\uD1B5\uC774 \uB418\uB294 \uBC14\uB78C\uC5D0 \uB2F9\uD669\uD588\uB2E4.
      \uC911\uC694\uD55C \uC219\uC81C \uC911\uC774\uC5C8\uB294\uB370, \uB2E4 \uB0A0\uC544\uAC04
      \uAC74 \uC544\uB2CC\uC9C0 \uAC71\uC815\uB3FC\uC11C \uC9C4\uC9DC \uBBF8\uCE60
      \uBED4 \uD588\uB2E4. \uBA87 \uBC88 \uC804\uC6D0\uC744 \uB20C\uB7EC\uBD24\uC9C0\uB9CC
      \uBC18\uC751\uC774 \uC5C6\uC5B4\uC11C \uADF8\uB0E5 \uD3EC\uAE30\uD588\uB2E4.
      \uB300\uCCB4 \uC65C \uC774\uB7EC\uB294 \uAC74\uC9C0 \uBAA8\uB974\uACA0\uB294\uB370,
      \uC774\uB7F0 \uC77C\uC774 \uB610 \uC0DD\uAE30\uBA74 \uC815\uB9D0 \uC2A4\uD2B8\uB808\uC2A4
      \uBC1B\uC744 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 702431237
    m_Localized: "\uD734\uB300\uD3F0\uC744 \uC5F4\uC5C8\uB294\uB370, \uC5F0\uB77D\uCC98\uAC00
      \uD145 \uBE44\uC5B4 \uC788\uC5C8\uB2E4. \uBD84\uBA85 \uAC00\uB4DD\uD588\uB358
      \uCE5C\uAD6C\uB4E4\uC758 \uC774\uB984\uC774 \uD558\uB098\uB3C4 \uBCF4\uC774\uC9C0
      \uC54A\uC544 \uD654\uBA74\uC744 \uACC4\uC18D \uB118\uACBC\uC9C0\uB9CC, \uB05D\uC5C6\uB294
      \uBE48\uCE78\uBFD0\uC774\uC5C8\uB2E4. \uBB54\uAC00 \uC798\uBABB\uB410\uB2E4\uACE0
      \uC0DD\uAC01\uD558\uBA74\uC11C\uB3C4, \uB204\uAD6C\uC5D0\uAC8C\uB3C4 \uC5F0\uB77D\uD560
      \uC218 \uC5C6\uB294 \uC0C1\uD669\uC774 \uC774\uC0C1\uD558\uB9AC\uB9CC\uD07C
      \uBB34\uAC81\uAC8C \uB290\uAEF4\uC84C\uB2E4. \uC774\uC820 \uB0B4\uAC00 \uB204\uAD70\uAC00\uC640
      \uC5F0\uACB0\uB418\uC5B4 \uC788\uB358 \uC801\uC774 \uC788\uAE34 \uD588\uB358
      \uAC74\uC9C0\uC870\uCC28 \uD63C\uB780\uC2A4\uB7EC\uC6CC\uC84C\uB2E4. \uAFC8\uC5D0\uC11C
      \uAE68\uC5B4\uB098 \uD655\uC778\uD55C \uC5F0\uB77D\uCC98\uC5D0 \uC774\uB984\uB4E4\uC774
      \uC5EC\uC804\uD788 \uC788\uC744 \uB54C\uC870\uCC28, \uADF8 \uBE48\uCE78\uC758
      \uAC10\uAC01\uC774 \uB5A0\uB098\uC9C0 \uC54A\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 702431238
    m_Localized: "\uAFC8\uC5D0\uC11C \uD55C \uC7A5\uC758 \uC0AC\uC9C4\uC774 \uB5A0\uC62C\uB790\uB2E4.
      \uBAA8\uB450\uAC00 \uC6C3\uC73C\uBA70 \uC5B4\uAE68\uB97C \uB9DE\uB300\uACE0
      \uC788\uB294 \uD654\uBAA9\uD55C \uAC00\uC871\uC758 \uBAA8\uC2B5\uC774\uC5C8\uB2E4.
      \uB530\uB73B\uD55C \uD587\uC0B4 \uC18D\uC5D0\uC11C \uADF8 \uC0AC\uC9C4\uC744
      \uBC14\uB77C\uBCF4\uB294 \uB0B4\uAC00 \uD589\uBCF5\uD588\uB358 \uAC83 \uAC19\uC740\uB370,
      \uAE68\uACE0 \uB098\uB2C8 \uADF8\uAC74 \uC804\uD600 \uC6B0\uB9AC \uAC00\uC871\uC758
      \uBAA8\uC2B5\uC774 \uC544\uB2C8\uC5C8\uB2E4\uB294 \uAC78 \uC54C\uC558\uB2E4.
      \uD604\uC2E4\uC5D0\uC11C \uC6B0\uB9AC \uAC00\uC871\uC774 \uD568\uAED8 \uC6C3\uB358
      \uAE30\uC5B5\uC740 \uC5C6\uC5C8\uB2E4. \uC774\uC0C1\uD558\uAC8C\uB3C4 \uADF8
      \uC0AC\uC9C4 \uC18D \uD48D\uACBD\uC774 \uB108\uBB34 \uC0DD\uC0DD\uD574\uC11C,
      \uB354 \uD5C8\uC804\uD558\uACE0 \uC5B4\uB518\uAC00 \uC544\uD508 \uAE30\uBD84\uC774
      \uB0A8\uC558\uB2E4. \uB9C8\uCE58 \uB0B4\uAC8C \uC5C6\uB294 \uAC83\uC744 \uAFC8\uC774
      \uC77C\uBD80\uB7EC \uBCF4\uC5EC\uC900 \uAC83 \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 702431239
    m_Localized: "\uC2F1\uD06C\uB300 \uC548\uC744 \uB4A4\uC838\uBD24\uC9C0\uB9CC,
      \uAC70\uAE30\uC5D4 \uD145 \uBE48 \uB0C4\uBE44\uC640 \uADF8\uB987\uB4E4\uBFD0\uC774\uC5C8\uB2E4.
      \uB77C\uBA74 \uD55C \uBD09\uC9C0\uB77C\uB3C4 \uC788\uC744\uAE4C \uC2F6\uC5B4
      \uCC2C\uC7A5\uC744 \uC5F4\uC5C8\uC9C0\uB9CC, \uAE30\uB300\uB294 \uAE08\uC138
      \uD5DB\uB41C \uAC78\uB85C \uBCC0\uD588\uB2E4. \uC9C0\uAC11 \uC18D\uC5D4 \uB3D9\uC804
      \uBA87 \uAC1C\uBFD0\uC774\uB77C, \uBB34\uC791\uC815 \uD3B8\uC758\uC810\uC5D0
      \uAC08 \uC218\uB3C4 \uC5C6\uC5C8\uB2E4. \uBC30\uB294 \uC810\uC810 \uAF2C\uC5EC
      \uC624\uB294 \uAC83 \uAC19\uACE0, \uBC29 \uC548 \uACF5\uAE30\uB294 \uCD95\uCD95\uD558\uAC8C
      \uB290\uAEF4\uC84C\uB2E4. \uC774\uB7F0 \uB0A0\uC740 \uC65C \uC2DC\uAC04\uAE4C\uC9C0
      \uB290\uB9AC\uAC8C \uAC00\uB294\uC9C0, \uC774\uB300\uB85C \uBC24\uC774 \uC624\uAE30\uB9CC
      \uAE30\uB2E4\uB9B4 \uC218\uBC16\uC5D0 \uC5C6\uC5C8\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 702431240
    m_Localized: "\uC0B0\uB354\uBBF8\uCC98\uB7FC \uC313\uC778 \uBB3C\uB958 \uBC15\uC2A4\uAC00
      \uB05D\uB3C4 \uC5C6\uC774 \uB098\uD0C0\uB0AC\uB2E4. \uD558\uB098\uB97C \uCE58\uC6B0\uBA74
      \uB610 \uB2E4\uB978 \uBC15\uC2A4\uAC00 \uADF8 \uC790\uB9AC\uC5D0 \uC0DD\uACA8\uB0AC\uACE0,
      \uB0B4 \uD314\uC740 \uC810\uC810 \uBB34\uAC70\uC6CC\uC84C\uB2E4. \uD53C\uACE4\uD568\uC774
      \uBAB0\uB824\uC654\uACE0, \uBC14\uB2E5\uC5D0 \uC8FC\uC800\uC549\uACE0 \uC2F6\uC5C8\uC9C0\uB9CC
      \uBA48\uCD9C \uC218 \uC5C6\uC5C8\uB2E4. \uB9E4\uB300\uB294 \uC5C9\uB9DD\uC774
      \uB418\uC5B4 \uAC00\uACE0, \uC190\uB2D8\uB4E4\uC758 \uC9DC\uC99D \uC11E\uC778
      \uBAA9\uC18C\uB9AC\uAC00 \uBA40\uB9AC\uC11C \uB4E4\uB824\uC628\uB2E4. \uC544
      \uC65C \uB0B4\uAC00 \uADFC\uBB34\uC77C \uB54C\uB9CC \uC774\uB7EC\uB294 \uAC70\uC57C.."
    m_Metadata:
      m_Items: []
  - m_Id: 706625536
    m_Localized: "\uC54C\uBC14\uC911\uC5D0 \uC190\uB2D8\uC774 \uCEF5\uB77C\uBA74\uC744
      \uB4E4\uACE0 \uAC00\uB358 \uC911, \uC190\uC774 \uBBF8\uB044\uB7EC\uC9C4 \uBAA8\uC591\uC774\uB2E4.
      \uCEF5\uB77C\uBA74\uC774 \uBC14\uB2E5\uC5D0 \uC5CE\uC5B4\uC9C0\uBA74\uC11C
      \uAD6D\uBB3C\uACFC \uBA74\uC774 \uC0AC\uBC29\uC73C\uB85C \uD37C\uC838 \uB098\uAC14\uB2E4.
      \uB728\uAC70\uC6B4 \uAD6D\uBB3C\uC774 \uD750\uB974\uBA70 \uBC14\uB2E5\uC740
      \uC5C9\uB9DD\uC774 \uB418\uC5C8\uB2E4. \uC544 \uC800 \uC0AC\uB78C\uC774 \uC624\uB298
      \uB2E4\uC12F \uBC88\uC9F8 \uC8FC\uC778\uACF5\uC774\uB2E4. \uC65C  \uB098\uB9CC
      \uC774\uB7EC\uB294 \uAC78\uAE4C. \uC790\uAE30\uAC00 \uC798\uBABB\uD558\uACE0
      \uBCC0\uC0C1\uD574\uB2EC\uB77C\uACE0 \uB098\uC5D0\uAC8C \uC2DC\uC704\uB3C4
      \uD55C\uB2E4. \uBCF8\uC778\uC774 \uC798\uBABB\uD588\uC796\uC544\uC694."
    m_Metadata:
      m_Items: []
  - m_Id: 706625537
    m_Localized: "\uC774\uC81C \uB05D\uB0B4\uACE0 \uC2F6\uB2E4. \uD558\uB8E8\uC5D0\uB3C4
      \uC5EC\uB7EC\uBC88 \uC529 \uADF8\uB7F0 \uC0DD\uAC01\uB4E4\uC774 \uBA38\uB9AC\uC18D\uC744
      \uAC00\uB4DD \uCC44\uC6B4\uB2E4. \uC0B6\uC740 \uACE0\uD1B5\uC774\uB2E4. \uADF8\uB798
      \uC624\uB298 \uB05D\uB0B4\uC790. \uC624\uB298 \uB05D\uB0B4\uB294 \uAC70\uC57C.
      \uB0B4 \uC0B6\uC5D0 \uBB34\uC2A8 \uAC00\uCE58\uAC00 \uC788\uC744\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 706625538
    m_Localized: "\uBB38\uC744 \uC5F4\uACE0 \uB4E4\uC5B4\uC11C\uC790\uB9C8\uC790
      \uC228\uC774 \uD131 \uB9C9\uD614\uB2E4. \uC7A5\uB871\uACFC \uC11C\uB78D\uC740
      \uD65C\uC9DD \uC5F4\uB824 \uC788\uACE0, \uBC14\uB2E5\uC5D4 \uBB3C\uAC74\uB4E4\uC774
      \uB9C8\uAD6C \uD769\uC5B4\uC838 \uC788\uC5C8\uB2E4. \uBC29 \uC548\uC774 \uB0AF\uC124\uACE0
      \uCC28\uAC11\uAC8C \uB290\uAEF4\uC84C\uACE0, \uC5B4\uB518\uAC00\uC5D0\uC11C
      \uC774\uC0C1\uD55C \uB0C4\uC0C8\uB9C8\uC800 \uB098\uB294 \uAC83 \uAC19\uC558\uB2E4.
      \uB3C4\uB451\uC774 \uB2E4\uB140\uAC04 \uAC8C \uBD84\uBA85\uD588\uB2E4\uB294
      \uC0DD\uAC01\uC5D0 \uBD84\uB178\uC640 \uB450\uB824\uC6C0\uC774 \uB4A4\uC11E\uC5EC
      \uAC00\uC2B4\uC774 \uCFF5\uCF85\uAC70\uB838\uB2E4. \uC5EC\uAE30\uC800\uAE30
      \uC0B4\uD3B4\uBD10\uB3C4 \uB2E4\uC2DC \uB418\uB3CC\uB9B4 \uC218 \uC5C6\uB294
      \uC0C1\uD669\uC774 \uB108\uBB34 \uD5C8\uBB34\uD558\uAC8C \uB290\uAEF4\uC84C\uB2E4.
      \uAC00\uC838\uAC08\uAC8C \uBB50\uAC00 \uC788\uB2E4\uACE0. \uC544\uBB34\uAC83\uB3C4
      \uC5C6\uB294\uB370. \uC544 \uC8FD\uC744\uAE4C."
    m_Metadata:
      m_Items: []
  - m_Id: 706625539
    m_Localized: "\uC624\uB298 \uBC29\uC5D0\uC11C \uACF5\uBD80\uD558\uB2E4\uAC00
      \uC774\uC0C1\uD55C \uAC78 \uBC1C\uACAC\uD588\uB2E4. \uBD84\uBA85 \uB0B4\uAC00
      \uB2EB\uC544\uB454 \uCC3D\uBB38\uC774 \uC5B4\uB290\uC0C8 \uC5F4\uB824 \uC788\uB294
      \uAC70\uB2E4. \uBC14\uB78C\uC774 \uBD88\uC5B4\uB3C4 \uC5F4\uB9B4 \uC77C\uC774
      \uC5C6\uC744 \uD150\uB370, \uC21C\uAC04 \uC18C\uB984\uC774 \uD655 \uB3CB\uC558\uB2E4.
      \uD639\uC2DC \uB0B4\uAC00 \uAE5C\uBE61\uD558\uACE0 \uC548 \uB2EB\uC740 \uAC74\uAC00
      \uC2F6\uC5B4 \uAE30\uC5B5\uC744 \uB418\uC9DA\uC5B4\uBD24\uC9C0\uB9CC, \uD655\uC2E4\uD788
      \uB2EB\uC740 \uAC8C \uB9DE\uB2E4. \uAD1C\uD788 \uB4A4\uC5D0\uC11C \uB204\uAC00
      \uC9C0\uCF1C\uBCF4\uACE0 \uC788\uB294 \uAC83 \uAC19\uC544 \uCC3D\uBB38\uC744
      \uB2E4\uC2DC \uB2EB\uACE0 \uCEE4\uD2BC\uAE4C\uC9C0 \uCCE4\uB2E4. \uC774\uC0C1\uD55C
      \uC77C\uC774 \uACC4\uC18D \uC0DD\uAE30\uBA74 \uC815\uB9D0 \uC2E0\uACBD \uC4F0\uC77C
      \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 706625540
    m_Localized: "\uCEF4\uD4E8\uD130 \uD654\uBA74\uC774 \uAC11\uC790\uAE30 \uD30C\uB797\uAC8C
      \uBB3C\uB4E4\uC5C8\uB2E4. \uC544\uBB34 \uAE00\uC790\uB3C4, \uADF8\uB9BC\uB3C4
      \uBCF4\uC774\uC9C0 \uC54A\uB294 \uD145 \uBE48 \uD30C\uB780\uBE5B\uC774 \uAC00\uB4DD\uD588\uB2E4.
      \uC190\uC744 \uC6C0\uC9C1\uC5EC\uB3C4, \uBC84\uD2BC\uC744 \uB20C\uB7EC\uB3C4
      \uC544\uBB34 \uBCC0\uD654\uB3C4 \uC5C6\uC5C8\uB2E4.  \uC800\uC7A5\uC740 \uD588\uB358\uAC00?
      \uC815\uB9D0 \uC544\uBB34\uAC83\uB3C4 \uD558\uAE30 \uC2EB\uB2E4. \uB05D\uC5C6\uB294
      \uC808\uB9DD\uAC10\uC774 \uB098\uB97C \uC9D3\uB204\uB978\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 706625541
    m_Localized: "\uC624\uB298 \uCEF4\uD4E8\uD130\uB85C \uBB58 \uD558\uB2E4\uAC00
      \uAC11\uC790\uAE30 \uD654\uBA74\uC774 \uC774\uC0C1\uD574\uC84C\uC5B4. \uD654\uBA74
      \uAC00\uB4DD \uC774\uC0C1\uD55C \uB178\uC774\uC988\uAC00 \uC0DD\uAE30\uB354\uB2C8,
      \uC544\uBB34\uAC83\uB3C4 \uBCF4\uC774\uC9C0 \uC54A\uC558\uC5B4. \uB9C8\uCE58
      \uB204\uAC00 \uC77C\uBD80\uB7EC \uB9DD\uAC00\uB728\uB9B0 \uAC83 \uAC19\uC544\uC11C
      \uC18C\uB984\uC774 \uB3CB\uC558\uC5B4. \uBA87 \uBC88 \uC7AC\uBD80\uD305\uD574\uB3C4
      \uB611\uAC19\uC544\uC11C \uADF8\uB0E5 \uC804\uC6D0\uC744 \uAEBC\uBC84\uB838\uC5B4.
      \uC774\uAC8C \uB2E8\uC21C\uD55C \uC624\uB958\uC77C\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 706625542
    m_Localized: "\uAFC8\uC5D0\uC11C \uD55C \uCABD\uC5D0 \uB193\uC778 \uC7A5\uB09C\uAC10\uC744
      \uBCF4\uACE0 \uAC78\uC74C\uC744 \uBA48\uCDC4\uB2E4. \uBD84\uBA85 \uC6B0\uB9AC
      \uC9D1\uC5D0 \uC788\uB358 \uAC8C \uC544\uB2CC\uB370, \uC5B4\uB514\uC11C \uC628
      \uAC74\uC9C0 \uC54C \uC218 \uC5C6\uC5C8\uB2E4. \uC5B5\uC9C0\uB85C \uC6C3\uB294
      \uB4EF\uD55C \uCC22\uC5B4\uC9C4 \uC785\uC774 \uC5B4\uB518\uAC00 \uBD88\uAE38\uD588\uB2E4.
      \uB538\uC774 \uB450\uACE0 \uAC04 \uAC74\uAC00 \uC2F6\uC5B4 \uBB3C\uC5B4\uBD24\uC9C0\uB9CC,
      \uBCF8 \uC801\uB3C4 \uC5C6\uB2E4\uB294 \uB300\uB2F5\uB9CC \uB3CC\uC544\uC654\uB2E4.
      \uC870\uC6A9\uD55C \uBC24, \uADF8 \uC7A5\uB09C\uAC10\uB97C \uAC00\uB9CC\uD788
      \uCCD0\uB2E4\uBCF4\uB294 \uAC83\uB9CC \uAC19\uC558\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 710819840
    m_Localized: "\uAFC8\uC18D\uC5D0\uC11C \uC11C\uC7AC\uB85C \uB4E4\uC5B4\uC130\uB2E4.
      \uC775\uC219\uD55C \uCC45\uB4E4\uC774 \uAC00\uB4DD\uD574\uC57C \uD560 \uCC45\uC7A5\uC774
      \uC774\uC0C1\uD558\uAC8C \uB0AF\uC124\uC5C8\uB2E4. \uAC00\uAE4C\uC774 \uB2E4\uAC00\uAC00
      \uBCF4\uB2C8 \uBAA8\uB4E0 \uCC45\uC774 \uB4A4\uC9D1\uD600 \uC788\uC5C8\uB2E4.
      \uC81C\uBAA9\uB3C4, \uD45C\uC9C0\uB3C4 \uBCF4\uC774\uC9C0 \uC54A\uACE0 \uC904\uC9C0\uC5B4
      \uB298\uC5B4\uC11C \uC788\uC5C8\uB2E4. \uC190\uC744 \uBED7\uC5B4 \uD55C \uAD8C\uC744
      \uBF51\uC544 \uBCF4\uB824 \uD588\uC9C0\uB9CC, \uC544\uBB34\uB9AC \uD798\uC744
      \uC918\uB3C4 \uBE60\uC9C0\uC9C0 \uC54A\uC558\uB2E4. \uC624\uB298\uC740 \uCC45\uC744
      \uC77D\uC73C\uBA74 \uC548 \uB420 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 710819841
    m_Localized: "\uC624\uB298 \uBC24\uC5D0 \uAC8C\uC784\uC744 \uD558\uACE0 \uC788\uC5C8\uB294\uB370,
      \uAC11\uC790\uAE30 \uD654\uBA74\uC5D0 \uADC0\uC2E0 \uAC19\uC740 \uAC8C \uD280\uC5B4\uB098\uC654\uB2E4.
      \uC6D0\uB798 \uADF8\uB7F0 \uAC8C\uC784\uC774 \uC544\uB2C8\uC5C8\uB294\uB370,
      \uBB54\uAC00 \uC624\uB958\uB77C\uB3C4 \uB09C \uAC74\uC9C0 \uC18C\uB984 \uB07C\uCE58\uB294
      \uC5BC\uAD74\uC774 \uB531 \uB098\uD0C0\uB09C \uAC70\uC57C. \uC21C\uAC04 \uB108\uBB34
      \uB180\uB77C\uC11C \uB9C8\uC6B0\uC2A4\uB97C \uB5A8\uC5B4\uB728\uB838\uB294\uB370,
      \uADF8 \uB4A4\uB85C \uD654\uBA74\uC774 \uC544\uC608 \uBA48\uCDB0\uBC84\uB838\uB2E4.
      \uC774\uAC8C \uC9C4\uC9DC \uBC84\uADF8\uC778\uC9C0, \uC544\uB2C8\uBA74 \uB204\uAC00
      \uC7A5\uB09C\uCE5C \uAC74\uC9C0 \uBAA8\uB974\uACA0\uB294\uB370, \uB2E4\uC2DC
      \uCF1C\uAE30\uAC00 \uBB34\uC12D\uB2E4. \uAC8C\uC784\uC740 \uC7A0\uAE50 \uC26C\uB294
      \uAC8C \uC88B\uC744 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 715014144
    m_Localized: "\uC624\uB298 \uCEF4\uD4E8\uD130\uAC00 \uAC11\uC790\uAE30 \uAEBC\uC838
      \uBC84\uB838\uB2E4. \uC804\uAE30\uB3C4 \uBA40\uCA61\uD588\uB294\uB370, \uAC11\uC790\uAE30
      \uD654\uBA74\uC774 \uBA39\uD1B5\uC774 \uB418\uB294 \uBC14\uB78C\uC5D0 \uB2F9\uD669\uD588\uB2E4.
      \uC911\uC694\uD55C \uC219\uC81C \uC911\uC774\uC5C8\uB294\uB370, \uB2E4 \uB0A0\uC544\uAC04
      \uAC74 \uC544\uB2CC\uC9C0 \uAC71\uC815\uB3FC\uC11C \uC9C4\uC9DC \uBBF8\uCE60
      \uBED4 \uD588\uB2E4. \uBA87 \uBC88 \uC804\uC6D0\uC744 \uB20C\uB7EC\uBD24\uC9C0\uB9CC
      \uBC18\uC751\uC774 \uC5C6\uC5B4\uC11C \uADF8\uB0E5 \uD3EC\uAE30\uD588\uB2E4.
      \uB300\uCCB4 \uC65C \uC774\uB7EC\uB294 \uAC74\uC9C0 \uBAA8\uB974\uACA0\uB294\uB370,
      \uC774\uB7F0 \uC77C\uC774 \uB610 \uC0DD\uAE30\uBA74 \uC815\uB9D0 \uC2A4\uD2B8\uB808\uC2A4
      \uBC1B\uC744 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 715014145
    m_Localized: "\uBCBD\uC744 \uBC14\uB77C\uBCF4\uB294 \uC21C\uAC04, \uC628\uBAB8\uC774
      \uC5BC\uC5B4\uBD99\uC5C8\uB2E4. \uBCBD\uBA74 \uAC00\uB4DD \uB05D\uC5C6\uB294
      \uB208\uB4E4\uC774 \uB098\uB97C \uC751\uC2DC\uD558\uACE0 \uC788\uC5C8\uB2E4.
      \uD06C\uAE30\uB3C4 \uBAA8\uC591\uB3C4 \uC81C\uAC01\uAC01\uC774\uC9C0\uB9CC,
      \uBAA8\uB450 \uAC19\uC740 \uBC29\uD5A5\uC744 \uD5A5\uD574 \uC788\uC5C8\uB2E4.
      \uC2DC\uC120\uC744 \uB3CC\uB824\uB3C4, \uB208\uC744 \uAC10\uC544\uB3C4 \uADF8
      \uAC10\uAC01\uC740 \uC0AC\uB77C\uC9C0\uC9C0 \uC54A\uC558\uB2E4. \uB9C8\uCE58
      \uBCBD \uC790\uCCB4\uAC00 \uC228\uC744 \uC26C\uACE0, \uB098\uB97C \uC9C0\uCF1C\uBCF4\uACE0
      \uC788\uC5C8\uB2E4. \uADF8\uB7EC\uB2E4 \uB208\uC744 \uD55C \uBC88 \uAE5C\uBE61\uC774\uB2C8
      \uADF8\uB4E4\uC740 \uC5B4\uB290\uC0C8 \uC874\uC7AC\uD558\uC9C0\uB3C4 \uC54A\uC740
      \uAC83\uCC98\uB7FC \uC0AC\uB77C\uC84C\uB2E4\u2026 \uAE30\uAC00 \uB9CE\uC774
      \uD5C8 \uD574\uC9C4 \uBAA8\uC591\uC774\uB2E4. \uC544\uCE68\uC774 \uBC1D\uC73C\uBA74
      \uBCD1\uC6D0\uC5D0 \uAC00\uBD10\uC57C\uACA0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 715014146
    m_Localized: "\uC870\uC6A9\uD55C \uBC29 \uC548, \uD734\uB300\uD3F0\uC774 \uAC11\uC790\uAE30
      \uC6C5\uC6C5 \uC6B8\uB9AC\uB354\uB2C8 \uC2A4\uD53C\uCEE4\uC5D0\uC11C \uC775\uC219\uD55C
      \uBAA9\uC18C\uB9AC\uAC00 \uD758\uB7EC\uB098\uC654\uB2E4. \uC544\uB0B4\uC600\uB2E4.
      \uADF8\uB7F0\uB370 \uADF8 \uBAA9\uC18C\uB9AC\uB294 \uD3C9\uC18C\uC640 \uC804\uD600
      \uB2EC\uB790\uB2E4. \uCC28\uAC11\uACE0 \uB0A0 \uC120 \uD1A4\uC73C\uB85C \uAC70\uCE5C
      \uC695\uC124\uC744 \uB0B4\uBC49\uACE0 \uC788\uC5C8\uB2E4. \uBD84\uBA85\uD788
      \uC544\uB0B4\uC758 \uBAA9\uC18C\uB9AC\uC778\uB370, \uB0B4\uAC00 \uC54C\uB358
      \uC0AC\uB78C\uC774 \uC544\uB2CC \uAC83 \uAC19\uC558\uB2E4. \uB098\uC911\uC5D0
      \uD655\uC778\uD574 \uBCF4\uB2C8 \uC544\uB0B4\uB294 \uC804\uD654\uB97C \uD55C
      \uC801\uC774 \uC5C6\uB2E4\uACE0 \uD55C\uB2E4. \uC5B4\uB5BB\uAC8C \uB41C \uC77C\uC77C\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 715014147
    m_Localized: "\uCD9C\uC7A5\uC744 \uC790\uC8FC \uB098\uAC00, \uAC00\uC871 \uC0AC\uC774\uC5D0
      \uB098\uC758 \uC790\uB9AC\uAC00 \uC5C6\uB294 \uAC83 \uCC98\uB7FC \uB290\uAEF4\uC9C4\uB2E4.
      \uB538\uC544\uC774\uB294 \uB098\uB97C \uC5B4\uC0C9\uD574\uD558\uACE0 \uC544\uB0B4
      \uC5ED\uC2DC\uB3C4 \uC9D1 \uBC16\uC744 \uC790\uC8FC \uBC30\uD68C\uD558\uB294
      \uB098\uB97C \uD0D0\uD0C1\uCE58 \uC54A\uC544\uD55C\uB2E4. \uC26C\uACE0 \uC788\uC9C0\uB9CC
      \uAC00\uC2DC\uBC29\uC11D\uC774\uB2E4. \uC774\uACF3\uC774 \uB098\uC758 \uC9D1\uC778
      \uAC83\uC77C\uAE4C? \uB098\uB294 \uADF8\uC800 \uB3C8\uC744 \uBC8C\uC5B4\uB2E4
      \uC8FC\uB294 \uAE30\uACC4\uC5D0 \uBD88\uACFC\uD55C\uAC8C \uC544\uB2D0\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 715014148
    m_Localized: "\uC774\uC81C \uB05D\uB0B4\uACE0 \uC2F6\uB2E4. \uD558\uB8E8\uC5D0\uB3C4
      \uC5EC\uB7EC\uBC88 \uC529 \uADF8\uB7F0 \uC0DD\uAC01\uB4E4\uC774 \uBA38\uB9AC\uC18D\uC744
      \uAC00\uB4DD \uCC44\uC6B4\uB2E4. \uC0B6\uC740 \uACE0\uD1B5\uC774\uB2E4. \uADF8\uB798
      \uC624\uB298 \uB05D\uB0B4\uC790. \uC624\uB298 \uB05D\uB0B4\uB294 \uAC70\uC57C.
      \uB0B4 \uC0B6\uC5D0 \uBB34\uC2A8 \uAC00\uCE58\uAC00 \uC788\uC744\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 715014149
    m_Localized: "\uBD84\uBA85 \uC544\uCE68\uC5D0 \uC815\uB9AC\uD574 \uB454 \uCC45\uC0C1\uC774
      \uB9C8\uCE58 \uB204\uAD70\uAC00 \uC77C\uBD80\uB7EC \uC5B4\uC9C0\uB7FD\uD600
      \uB193\uC740 \uAC83 \uAC19\uC774 \uC5C9\uB9DD\uC774\uB2E4. \uC190\uC744 \uBED7\uC5B4
      \uC815\uB9AC\uD558\uB824 \uD574\uB3C4 \uC5B4\uB514\uC11C \uBD80\uD130 \uC190\uC744
      \uB300\uC57C \uD560\uC9C0 \uB9C9\uB9C9\uD588\uB2E4. \uC774 \uD63C\uB780\uC2A4\uB7EC\uC6B4
      \uACF5\uAC04\uC774 \uC9C0\uAE08 \uB0B4 \uBA38\uB9BF\uC18D\uC744 \uADF8\uB300\uB85C
      \uBE44\uCD94\uB294 \uAC83\uB9CC \uAC19\uC558\uB2E4. \uBD84\uBA85\uD788 \uC11C\uC7AC\uB294
      \uB4E4\uC5B4\uC624\uC9C0 \uB9D0\uB77C\uACE0 \uD588\uB294\uB370. \uC720\uC77C\uD55C
      \uB098\uC758 \uC548\uC2DD\uCC98\uAC00 \uCE68\uBC94\uB2F9\uD55C \uB290\uB08C\uC774\uB2E4.
      \uC2A4\uD2B8\uB808\uC2A4\uAC00 \uBAB0\uB824\uC628\uB2E4. "
    m_Metadata:
      m_Items: []
  - m_Id: 715014150
    m_Localized: "\uC601\uC6D0\uD560 \uAC83 \uAC19\uC558\uB358 \uB0B4 \uCC45\uC0C1,
      \uC775\uC219\uD588\uB358 \uBAA8\uB4E0 \uBB3C\uAC74\uB4E4\uC774 \uC0AC\uB77C\uC838
      \uC788\uC5C8\uB2E4. \uD39C\uACFC \uC11C\uB958 \uB354\uBBF8, \uBAA8\uB2C8\uD130\uAE4C\uC9C0
      \uD754\uC801\uB3C4 \uC5C6\uC774 \uC0AC\uB77C\uC9C4 \uD145 \uBE48 \uCC45\uC0C1\uC774
      \uB0AF\uC124\uACE0 \uCC28\uAC00\uC6E0\uB2E4. \uC190\uC744 \uBED7\uC5B4 \uCC45\uC0C1
      \uC704\uB97C \uC4F8\uC5B4\uBCF4\uC558\uC9C0\uB9CC, \uB0A8\uC740 \uAC74 \uC544\uBB34\uAC83\uB3C4
      \uC5C6\uB2E4. \uAD8C\uACE0\uC0AC\uC9C1 \uC774\uC5C8\uB2E4. \uC774\uC81C\uC640\uC11C
      \uB098\uAC00\uB77C\uACE0? \uADF8\uB7FC \uB0B4 \uAC00\uC871\uC740? \uB538\uC544\uC774\uB294?
      \uBB34\uB98E \uAFC7\uACE0 \uC190\uC774 \uC5C6\uC5B4\uC838\uB77C \uC2F9\uC2F9
      \uBE4C\uBA70 \uD391\uD391 \uC6B8\uC5C8\uB2E4. \uCC9C\uB9CC \uB2E4\uD589\uD788\uB3C4
      \uAFC8\uC774\uC5C8\uB2E4. \uBA38\uB9AC\uAC00 \uBA4D\uD558\uB2E4. \uC624\uB298
      \uD558\uB8E8\uB294 \uD53C\uACE4\uD560 \uAC83 \uAC19\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 715014151
    m_Localized: "\uB538 \uC544\uC774\uAC00 \uC5B4\uB838\uC744 \uC801, \uB098\uC640
      \uB538\uC740 \uD56D\uC0C1 \uC798 \uBD99\uC5B4 \uC9C0\uB0C8\uB2E4. \uB0B4\uAC00
      \uC9D1\uC5D0 \uC5C6\uC744 \uC801\uC5D0\uB294 \uD56D\uC0C1 \uB0B4\uAC00 \uC5B8\uC81C
      \uC624\uB0D0\uBA70 \uC544\uB0B4\uB97C \uCD94\uAD81\uD558\uACE4 \uD588\uC5C8\uB2E4.
      \uB538\uC5D0\uAC8C\uB294 \uD56D\uC0C1 \uBBF8\uC548\uD560 \uBFD0\uC774\uB2E4.
      \uC774\uC81C\uB294 \uB098\uB97C \uAE30\uB2E4\uB9AC\uAE30\uB294 \uD560\uAE4C?
      \uAE30\uB2E4\uB9AC\uB2E4\uAC00 \uC9C0\uCE58\uC9C0\uB294 \uC54A\uC558\uC744\uAE4C?
      \uB9CC\uC57D \uADF8\uB807\uB2E4\uBA74, \uB098\uB294 \uB538\uC744 \uC5B4\uB5A4
      \uD45C\uC815\uC73C\uB85C \uB9DE\uC774\uD574\uC57C \uD560\uAE4C?"
    m_Metadata:
      m_Items: []
  - m_Id: 715014152
    m_Localized: "\uD55C\uAD6C\uC11D\uC5D0 \uB193\uC778 \uB538\uC758 \uC7A5\uB09C\uAC10\uC774
      \uB208\uC5D0 \uB744\uC5C8\uB2E4. \uC6D0\uB798\uB294 \uB098\uB97C \uD5A5\uD574
      \uC788\uB358 \uC778\uD615\uC774 \uC774\uC0C1\uD558\uAC8C\uB3C4 \uBC18\uB300
      \uBC29\uD5A5\uC744 \uBC14\uB77C\uBCF4\uACE0 \uC788\uC5C8\uB2E4. \uCC98\uC74C\uC5D4
      \uB538\uC774 \uC7A5\uB09C\uCE5C \uAC83\uC778\uAC00 \uC0DD\uAC01\uD558\uBA70
      \uB2E4\uC2DC \uB3CC\uB824\uB193\uC558\uC9C0\uB9CC, \uB098\uC911\uC5D0 \uBCF4\uBA74
      \uC5B8\uC81C\uB098 \uAC19\uC740 \uBC29\uD5A5\uC774\uC5C8\uB2E4. \uB9C8\uCE58
      \uC77C\uBD80\uB7EC \uB098\uB97C \uC678\uBA74\uD558\uB294 \uAC83\uCC98\uB7FC.
      \uBA87 \uBC88\uC774\uACE0 \uC778\uD615\uC744 \uB098\uB97C \uD5A5\uD558\uAC8C
      \uD588\uC9C0\uB9CC, \uC5B4\uB290 \uC21C\uAC04 \uB2E4\uC2DC \uB3CC\uC544\uAC00
      \uC788\uC5C8\uB2E4. \uBB38\uB4DD, \uADF8\uAC83\uC774 \uB538\uC758 \uB9C8\uC74C\uC744
      \uB300\uBCC0\uD558\uB294 \uAC74 \uC544\uB2D0\uAE4C \uD558\uB294 \uC0DD\uAC01\uC774
      \uB4E0\uB2E4."
    m_Metadata:
      m_Items: []
  - m_Id: 719208448
    m_Localized: "\uAC70\uC2E4 TV\uC5D0\uC11C\uB294 \uD3C9\uBC94\uD55C \uAC00\uC871
      \uB4DC\uB77C\uB9C8\uAC00 \uD758\uB7EC\uB098\uC624\uACE0 \uC788\uC5C8\uB2E4.
      \uB530\uB73B\uD55C \uBBF8\uC18C\uB97C \uC9D3\uB294 \uBD80\uBAA8, \uC6C3\uC73C\uBA70
      \uC7A5\uB09C\uCE58\uB294 \uC544\uC774\uB4E4. \uD558\uC9C0\uB9CC \uD654\uBA74\uC774
      \uAC11\uC790\uAE30 \uC77C\uADF8\uB7EC\uC9C0\uB354\uB2C8, \uC5BC\uAD74\uB4E4\uC774
      \uAE30\uAD34\uD558\uAC8C \uBE44\uD2C0\uB9AC\uAE30 \uC2DC\uC791\uD588\uB2E4.
      \uD658\uD55C \uBBF8\uC18C\uAC00 \uC77C\uADF8\uB7EC\uC9C4 \uCC44 \uCC22\uC5B4\uC9C0\uACE0,
      \uAC80\uC740 \uAD6C\uBA4D \uAC19\uC740 \uB208\uC774 \uD654\uBA74 \uC18D\uC5D0\uC11C
      \uB098\uB97C \uC751\uC2DC\uD588\uB2E4. \uC21C\uAC04 TV\uC5D0\uC11C \uBB34\uC5B8\uAC00\uAC00
      \uD280\uC5B4\uB098\uC654\uACE0, \uC2F8\uB298\uD55C \uAE30\uC6B4\uC774 \uBC29
      \uC548\uC744 \uAC00\uB4DD \uCC44\uC6E0\uB2E4. \uC798\uBABB \uBCF8 \uAC83\uC77C\uAE4C
      \uB208\uC744 \uBE44\uBE44\uC790 \uC21C\uC2DD\uAC04\uC5D0 \uC815\uC0C1\uC73C\uB85C
      \uB3CC\uC544\uC654\uB2E4. \uB098\uB294 \uD589\uBCF5\uD55C \uAC00\uC815\uC744
      \uAC00\uC9C8 \uC790\uACA9\uC774 \uC5C6\uB2E4\uB294 \uAC83\uC778\uAC00..? "
    m_Metadata:
      m_Items: []
