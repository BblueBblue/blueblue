    \uBB3C\uC5B4\uBD24\uB354\uB2C8 \uD654\uB97C \uB0C8\uC5B4. \uC544\uBE60\uB294
    \uBC14\uBE60\uC11C \uBABB \uC624\uB294 \uAC70\uB77C\uB294\uB370, \uBC14\uBE60\uB3C4
    \uB098 \uBCF4\uACE0 \uC2F6\uC744 \uD150\uB370. \uC0AC\uC9C4\uC744 \uB2E4\uC2DC
    \uBD99\uC5EC\uBCF4\uB824\uACE0 \uD588\uB294\uB370, \uC798 \uC548 \uB9DE\uC544\uC11C
